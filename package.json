{
  "name": "youssef-operations-kit",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:kit": "node --test kit/utilities/url-filters/filters.test.mjs",
    "dev": "astro dev",
    "lint": "eslint resources/js kit/utilities/url-filters/filters.ts kit/components/search-dialog/*.tsx tests/browser playwright.config.ts vite.config.ts --max-warnings=0",
    "format:check": "prettier --check resources/js resources/css kit/utilities/url-filters/filters.ts \"kit/components/*/*.{tsx,css,html}\" tests/browser playwright.config.ts vite.config.ts eslint.config.js",
    "typecheck": "tsc -p tsconfig.catalogue.json --noEmit",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "dev:catalogue": "vite",
    "build:catalogue": "npm run typecheck && vite build",
    "test:workbench": "playwright test --config playwright.workbench.config.mjs"
  },
  "dependencies": {
    "@astrojs/alpinejs": "^0.4.9",
    "@astrojs/check": "^0.9.12",
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/react": "^4.4.2",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@inertiajs/react": "^3.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/alpinejs": "^3.17.0",
    "alpinejs": "^3.17.5",
    "astro": "^5.18.2",
    "docx-preview": "^0.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.78.0",
    "mermaid": "^11.17.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shiki": "^3.23.0",
    "tailwindcss": "^4.3.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inertiajs/vite": "^3.0.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "js-yaml": "^4.3.2",
    "laravel-vite-plugin": "^3.0.0",
    "prettier": "^3.10.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.0.0"
  }
}
