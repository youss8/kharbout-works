{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "youss8/operations-kit",
    "type": "project",
    "description": "A catalogue of reusable software components, pages, utilities, modules and AI tools.",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-phar": "*",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "larastan/larastan": "^3.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/pestphp/pest/bin/pest",
        "analyse": "@php vendor/phpstan/phpstan/phpstan analyse",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
