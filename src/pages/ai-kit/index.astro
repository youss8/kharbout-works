---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import PromptCompiler from '../../components/toolkit/PromptCompiler.astro';
import ResourceIndex from '../../components/resources/ResourceIndex.astro';
import { promptBuilderEnabled } from '../../lib/prompt-builder/release';
import { builderPath } from '../../lib/prompt-builder/workflows';
import '../../styles/workbench.css';
import '../../styles/resource-workspaces.css';

const items = (await getCollection('ai-kit')).sort((a, b) => a.data.order - b.data.order);
const kinds = [
    { id: '', title: 'All' },
    { id: 'gem', title: 'Custom Gems' },
    { id: 'skill', title: 'Coding Skills' },
    { id: 'workflow', title: 'Automation Workflows' },
];
const categories = [...new Set(items.map((item) => item.data.category))];
const index = items.map(({ data }) => ({
    id: data.id,
    kind: data.kind,
    category: data.category,
    text: [
        data.title,
        data.id,
        data.kind,
        data.category,
        data.summary,
        ...data.compatibility,
        ...data.variables.map((v) => v.key),
    ]
        .join(' ')
        .toLowerCase(),
}));
---

<BaseLayout
    title="AI engineering toolkit"
    description="Compile and download reusable architecture, code review and operations prompts."
>
    <div class="page-shell resource-shell">
        <header class="page-heading resource-heading">
            <h1>AI engineering toolkit</h1>
            <p>
                Choose a Gem, coding skill or workflow. Set its inputs, inspect the compiled prompt
                and take it into your engineering tools.
            </p>
            <div class="resource-links">
                <a class="skills-link" href="/ai-kit/prompt-evidence/">
                    Compare tested prompts
                </a>
                {promptBuilderEnabled() && (
                    <a class="builder-link" href={builderPath}>
                        Build a prompt <span aria-hidden="true">↗</span>
                    </a>
                )}
                <a class="skills-link" href="/claude-code-skills/">
                    Browse Claude Code skills
                </a>
            </div>
        </header>
        <div
            class="kit-grid resource-workspace"
            data-index={JSON.stringify(index)}
            x-data={String.raw`{
            items: JSON.parse($el.dataset.index), kind: '', category: '', query: '', active: '',
            get matches() {
                const words = this.query.trim().toLowerCase().split(/\s+/).filter(Boolean);
                return this.items.filter(it => (!this.kind || it.kind === this.kind) && (!this.category || it.category === this.category) && words.every(w => it.text.includes(w)))
            },
            init() { this.followHash() },
            resetFilters() { this.query = ''; this.kind = ''; this.category = '' },
            followHash() {
                const id = location.hash.slice(1);
                if (this.items.some(it => it.id === id)) {
                    if (!this.matches.some(it => it.id === id)) this.resetFilters();
                    this.active = id
                } else {
                    this.resetFilters();
                    this.active = this.items[0]?.id ?? ''
                }
            },
            filter() {
                if (this.matches.some(it => it.id === this.active)) return;
                this.active = this.matches[0]?.id ?? '';
                const url = new URL(location.href);
                url.hash = this.active;
                if (url.href !== location.href) history.pushState(null, '', url)
            },
            choose(id) {
                this.active = id;
                if (location.hash !== '#' + id) history.pushState(null, '', '#' + id);
            }
        }`}
            x-on:hashchange.window="followHash()"
            x-on:popstate.window="followHash()"
        >
            <aside class="kit-register resource-register" aria-label="Prompt directory">
                <ResourceIndex
                    title="Browse blueprints"
                    count={items.length}
                    id="blueprint-directory"
                >
                    <label class="search-label" x-cloak>
                        Search toolkit
                        <input
                            type="search"
                            placeholder="Name, variable or technology"
                            x-ref="query"
                            x-model="query"
                            x-on:input="filter()"
                        />
                    </label>
                    <fieldset x-cloak>
                        <legend>Kind</legend>
                        <div class="filter-list">
                            {kinds.map((k) => (
                                <button
                                    type="button"
                                    x-bind:aria-pressed={`kind === '${k.id}'`}
                                    x-on:click={`kind = '${k.id}'; filter()`}
                                >
                                    {k.title}
                                </button>
                            ))}
                        </div>
                    </fieldset>
                    <fieldset x-cloak>
                        <legend>Category</legend>
                        <div class="filter-list">
                            {['', ...categories].map((c) => (
                                <button
                                    type="button"
                                    x-bind:aria-pressed={`category === '${c}'`}
                                    x-on:click={`category = '${c}'; filter()`}
                                >
                                    {c || 'All categories'}
                                </button>
                            ))}
                        </div>
                    </fieldset>
                    <p
                        class="count"
                        role="status"
                        x-text="matches.length + (matches.length === 1 ? ' prompt' : ' prompts')"
                    >
                        {items.length} prompts
                    </p>
                    <nav aria-label="Toolkit entries">
                        {items.map(({ data }) => (
                            <a
                                href={'#' + data.id}
                                x-show={`matches.some(it => it.id === '${data.id}')`}
                                x-bind:aria-current={`active === '${data.id}' ? 'true' : null`}
                                x-on:click.prevent={`choose('${data.id}')`}
                            >
                                {data.title}
                                <small>
                                    {data.kind} · {data.category}
                                </small>
                            </a>
                        ))}
                    </nav>
                </ResourceIndex>
            </aside>
            <div class="kit-detail">
                <div x-show="!matches.length" class="kit-empty" x-cloak>
                    <h2>No matching prompts</h2>
                    <button
                        type="button"
                        x-on:click="resetFilters(); filter(); $refs.query.focus()"
                    >
                        Clear filters
                    </button>
                </div>
                {items.map((item) => (
                    <article
                        id={item.data.id}
                        tabindex="-1"
                        x-show={`active === '${item.data.id}'`}
                    >
                        <PromptCompiler item={item} />
                    </article>
                ))}
            </div>
        </div>
    </div>
</BaseLayout>
<style>
    .skills-link {
        color: var(--accent-primary);
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }
    .builder-link {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        min-height: 44px;
        margin-block-start: 1rem;
        padding: 0.5rem 0.85rem;
        border: 1px solid var(--accent-primary);
        border-radius: 0.3rem;
        background: var(--accent-tint);
        color: var(--accent-primary);
        font-size: 0.9rem;
        font-weight: 700;
        text-decoration: none;
    }
    .builder-link:hover {
        text-decoration: underline;
    }
    .kit-grid {
        display: grid;
        grid-template-columns: minmax(15rem, 19rem) minmax(0, 1fr);
        align-items: start;
        gap: clamp(1rem, 3vw, 2.5rem);
    }
    .kit-register,
    .kit-detail article,
    .kit-empty {
        background: var(--bg-surface);
        border: 1px solid var(--border-hairline);
    }
    .kit-register {
        padding: 0;
    }
    .search-label,
    legend {
        font-size: 0.84rem;
        font-weight: 600;
    }
    .search-label {
        display: grid;
        gap: 0.3rem;
    }
    input {
        width: 100%;
        border: 1px solid var(--border-strong);
        background: var(--bg-canvas);
        padding: 0.5rem;
        border-radius: 3px;
    }
    fieldset {
        margin-block-start: 0.85rem;
    }
    .filter-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem;
        margin-block-start: 0.3rem;
    }
    button {
        border: 1px solid var(--border-strong);
        border-radius: 3px;
        padding: 0.26rem 0.45rem;
        font-size: 0.77rem;
    }
    button[aria-pressed='true'] {
        color: var(--accent-primary);
        border-color: var(--accent-primary);
        background: var(--accent-tint);
    }
    .count,
    small {
        color: var(--ink-secondary);
        font: 0.7rem/1.5 var(--font-mono);
    }
    .count {
        margin: 1rem 0 0.3rem;
    }
    nav {
        display: grid;
    }
    nav a {
        display: block;
        padding: 0.55rem;
        border-block-start: 1px solid var(--border-hairline);
        font-size: 0.87rem;
        line-height: 1.35;
        font-weight: 600;
    }
    nav a[aria-current='true'] {
        border-inline-start: 3px solid var(--accent-primary);
        color: var(--accent-primary);
        background: var(--accent-tint);
    }
    small {
        display: block;
        margin-block-start: 0.15rem;
    }
    .kit-detail {
        min-width: 0;
    }
    article,
    .kit-empty {
        padding: clamp(0.8rem, 2vw, 1.7rem);
    }
    .kit-empty h2 {
        margin-block-end: 0.65rem;
    }
    @media (max-width: 760px) {
        .kit-grid {
            grid-template-columns: 1fr;
        }
        nav {
            overflow: auto;
            max-height: 14rem;
        }
    }
</style>
