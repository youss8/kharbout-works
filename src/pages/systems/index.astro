---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import StatusBadge from '../../components/ui/StatusBadge.astro';
import { sandboxTitles, securitySummaries } from '../../data/sandbox-directory';
import '../../styles/workbench.css';
const systems = (await getCollection('systems')).sort((a, b) => a.data.order - b.data.order);
const rows = [
    ['Ecosystem', (s: typeof systems[number]) => s.data.ecosystem],
    ['Direct ownership', (s: typeof systems[number]) => s.data.ownershipBadge],
    ['Codebase scale', (s: typeof systems[number]) => s.data.keyMetrics.slice(0, 3).map(m => m.value + ' ' + m.label).join(' · ')],
    ['Operational scope', (s: typeof systems[number]) => s.data.realWorldScale],
    ['Modeling challenge', (s: typeof systems[number]) => s.data.toughestProblemSummary],
    ['Security architecture', (s: typeof systems[number]) => securitySummaries[s.data.code]],
] as const;
---
<BaseLayout title="Systems comparison">
    <div class="page-shell">
        <header class="page-heading"><p class="section-id">01 / Systems</p><h1>Systems comparison</h1><p>Three enterprise platforms, their ownership boundaries, and six working demonstrations using synthetic data.</p></header>
        <div class="systems-matrix">
            <table><caption class="sr-only">Compare the three engineering case studies</caption>
                <thead><tr><th scope="col">Engineering scope</th>{systems.map(s => <th scope="col"><StatusBadge label={s.data.code} shape="outline"/><h2><a href={'/systems/'+s.id+'/'}>{s.data.title}</a></h2></th>)}</tr></thead>
                <tbody>{rows.map(([label, read]) => <tr><th scope="row">{label}</th>{systems.map(s => <td data-code={s.data.code}>{read(s)}</td>)}</tr>)}
                    <tr><th scope="row">Live sandboxes</th>{systems.map(s => <td data-code={s.data.code}>{s.data.demoIds.map(id => <a class="table-link" href={'/systems/'+s.id+'/#'+id}>{sandboxTitles[id]}</a>)}</td>)}</tr>
                </tbody>
            </table>
        </div>
    </div>
</BaseLayout>
<style>
    .systems-matrix table { width: 100%; table-layout: fixed; border: 1px solid var(--border-hairline); background: var(--bg-surface); }
    .systems-matrix :is(td,th) { padding: clamp(.8rem,1.7vw,1.5rem); vertical-align: top; border: 1px solid var(--border-hairline); text-align: start; }
    .systems-matrix th:first-child { width: 16%; background: var(--bg-subtle); font-size: .84rem; }
    .systems-matrix td { font-size: .92rem; }
    h2 { margin-top: .9rem; font-size: 1.32rem; }
    a:hover { text-decoration: underline; }
    .table-link { display: block; color: var(--accent-primary); text-decoration: underline; margin-bottom: .5rem; }
    @media (max-width: 740px) {
        .systems-matrix :is(table,thead,tbody,tr,td,th) { display: block; width: 100%; }
        .systems-matrix table { border: 0; }
        .systems-matrix th:first-child { width: 100%; }
        .systems-matrix td::before { content: attr(data-code); display: block; font: 600 .72rem var(--font-mono); color: var(--accent-primary); margin-bottom: .3rem; }
        .systems-matrix tr { margin-block-end: 1rem; }
    }
</style>
