---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import FlagshipCaseStudy from '../../components/ui/FlagshipCaseStudy.astro';
import SectionRail from '../../components/ui/SectionRail.astro';
import StatusBadge from '../../components/ui/StatusBadge.astro';
import SystemSandboxes from '../../components/ui/SystemSandboxes.astro';
import { sandboxTitles } from '../../data/sandbox-directory';
import '../../styles/workbench.css';
export async function getStaticPaths() {
    return (await getCollection('systems')).map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
interface Props { entry: CollectionEntry<'systems'> }
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
---
<BaseLayout title={data.title} description={data.scopeNote}>
    {data.presentation ? <FlagshipCaseStudy data={data} presentation={data.presentation}>
        <SystemSandboxes slot="workflows" code={data.code} order={data.order} demoIds={data.demoIds} featured />
        <Content />
    </FlagshipCaseStudy> :
    <div class="page-shell">
        <header class="page-heading"><a class="section-id" href="/systems/">01 / Systems</a><p class="case-id">{data.code}</p><h1>{data.title}</h1><p>{data.subtitle}</p></header>
        <div class="study-grid">
            <SectionRail />
            <article class="study">
                <section id="scope" class="scope-panel">
                    <h2>Ownership and scope</h2><StatusBadge label={data.ownershipBadge} shape="surface"/>
                    <dl><dt>Team</dt><dd>{data.teamSize}</dd><dt>Youssef’s direct ownership</dt><dd>{data.scopeNote}</dd><dt>Operational scale</dt><dd>{data.realWorldScale}</dd></dl>
                    <div class="demo-links">{data.demoIds.map(id => <a href={'#'+id}>{sandboxTitles[id]} ↓</a>)}</div>
                </section>
                <div class="study-copy"><Content /></div>
                <SystemSandboxes code={data.code} order={data.order} demoIds={data.demoIds} />
            </article>
        </div>
    </div>}
</BaseLayout>
