---
import { ArrowDownRight, ArrowRight, ArrowUpRight, Boxes, Braces, ChartNoAxesCombined, Check, CircuitBoard, CodeXml, Database, FileStack, FlaskConical, GitBranch, Layers3, Network, ScanLine, Users } from "lucide-react";
import BaseLayout from "../components/layout/BaseLayout.astro";
import MetricStrip from "../components/ui/MetricStrip.astro";
import { profile } from "../data/profile";

const builtPages = import.meta.glob("/src/pages/**/*.{astro,ts}");
const available = (slug: string) => `/src/pages/${slug}/index.astro` in builtPages;
const systems = [
  { code: "SYS-01", key: "IT-OPS", slug: "01-it-ops-helpdesk", title: "IT Operations & Asset Helpdesk", owner: "100% Solo", scope: "Solo end-to-end architecture & build. Architecture-verified, held from live fleet rollout.", stack: ["React 19", "TypeScript", "PostgreSQL"], metrics: [["47", "Live tables"], ["54", "Triggers"], ["~118", "RLS policies"], ["11", "MCP tools"]], nodes: ["Service desk", "Postgres RLS", "Field history"], icons: [CircuitBoard, Database, GitBranch], problem: "One database trigger records immutable, field-level changes across operational registers." },
  { code: "SYS-02", key: "HR-CRM", slug: "02-hr-lifecycle-crm", title: "HR Lifecycle Platform", owner: "Core Pre-RMS", scope: "Core full-stack contributor and co-architect on a three-developer team. Metrics cover the full platform.", stack: ["Laravel 13", "Livewire 4", "MySQL"], metrics: [["136", "Tables"], ["138", "Migrations"], ["29", "Policies"], ["293", "Test files"]], nodes: ["Leave request", "Manager", "HR review"], icons: [FileStack, Users, Check], problem: "One deterministic leave quote powers previews, reservations, deductions and approval refunds." },
  { code: "SYS-03", key: "KPI-ENGINE", slug: "03-portfolio-kpi-engine", title: "Funding, Portfolio & KPI Analytics", owner: "~80% Primary", scope: "Primary architect and full-stack builder on a three-developer team. Metrics cover the full platform.", stack: ["PHP 8.5", "Laravel 13", "MySQL"], metrics: [["~98", "Live tables"], ["197", "Migrations"], ["175", "Actions"], ["481", "Test files"]], nodes: ["Site return", "Measurement", "Pooled KPI"], icons: [FileStack, Database, ChartNoAxesCombined], problem: "PHP and SQL pool site numerators and denominators to keep reported ratios statistically valid." },
];
const directory = [
  { path: "systems", name: "System sandboxes", count: "06", detail: "Explore queues, approvals, funding and KPI calculations.", icon: Network },
  { path: "vault", name: "Component vault", count: "10", detail: "Inspect and reuse dual-stack interface patterns.", icon: Layers3 },
  { path: "ai-kit", name: "AI engineering toolkit", count: "11", detail: "Compile and export Gems, skills and workflows.", icon: Braces },
  { path: "templates", name: "Operations templates", count: "05", detail: "Download architecture, planning and handover documents.", icon: FileStack },
  { path: "lab", name: "R&D lab", count: "04", detail: "Try independent product and interaction prototypes.", icon: FlaskConical },
];
const askAvailable = "/src/pages/search-index.json.ts" in builtPages;
---
<BaseLayout title={`${profile.fullName} — Engineering Workbench`} description={`${profile.fullName}’s software engineering portfolio, interactive systems, reusable operations kit and CV for commercial tech roles.`}>
  <div class="workbench">
    <div class="workbench-title"><span aria-hidden="true" class="locator">⌖</span> Engineering workbench</div>
    <section class="hero" aria-labelledby="home-title">
      <div class="intro">
        <div class="availability"><Check size={13} strokeWidth={2.8} aria-hidden="true"/><span>{profile.availability.badge} · REMOTE / GERMANY RELOCATION</span></div>
        <h1 id="home-title">{profile.fullName}</h1>
        <p class="role">{profile.headline}</p>
        <p class="pitch">{profile.subheadline} {profile.availability.careerFocus}</p>
        <div class="hero-actions">
          <a class="action primary" href={available("systems") ? "/systems/" : "#architecture"}>{available("systems") ? "Explore 3 systems & 6 live demos" : "Explore the 3 systems"}<ArrowRight size={15} aria-hidden="true"/></a>
          <a class="action secondary" href="/cv/">Interactive CV & PDF <ArrowUpRight size={15} aria-hidden="true"/></a>
        </div>
        {askAvailable && <button class="search-hint" type="button" data-ask-open aria-haspopup="dialog"><kbd>Ctrl K</kbd> Search the operations kit <ArrowRight size={12} aria-hidden="true"/></button>}
      </div>
      <div class="switcher" id="architecture" x-data="{ active: 0, choose(i, focus) { this.active = i; if (focus) document.getElementById('system-tab-' + i)?.focus(); } }">
        <div class="switcher-head"><strong><Boxes size={16} aria-hidden="true"/>System architecture</strong><span class="sheet-count"><span x-text="String(active + 1).padStart(2, '0')">01</span> / 03</span></div>
        <div class="tabs" role="tablist" aria-label="System architecture">
          {systems.map((sys, i) => <button type="button" role="tab" id={`system-tab-${i}`} aria-controls={`system-panel-${i}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}
            x-bind:aria-selected={`active === ${i}`} x-bind:tabindex={`active === ${i} ? 0 : -1`}
            x-on:click={`choose(${i}, false)`} x-on:keydown.right.prevent={`choose(${(i + 1) % systems.length}, true)`} x-on:keydown.left.prevent={`choose(${(i + systems.length - 1) % systems.length}, true)`} x-on:keydown.home.prevent="choose(0, true)" x-on:keydown.end.prevent="choose(2, true)">
            <span>{sys.code}</span> {sys.key}
          </button>)}
        </div>
        {systems.map((sys, i) => <article class="panel" role="tabpanel" tabindex="0" id={`system-panel-${i}`} aria-labelledby={`system-tab-${i}`} hidden={i !== 0} x-bind:hidden={`active !== ${i}`}>
          <div class="panel-title"><h2>{sys.title}</h2><span class:list={["ownership", { solo: i === 0 }]}>{i === 0 ? <CodeXml size={12} aria-hidden="true"/> : <Users size={12} aria-hidden="true"/>}{sys.owner}</span></div>
          <p class="scope">{sys.scope}</p>
          <div class="diagram" aria-label="Workflow" role="group">
            {sys.nodes.map((node, n) => { const Icon = sys.icons[n]!; return <div class="diagram-node"><span class="symbol"><Icon size={18} strokeWidth={1.6} aria-hidden="true"/></span><span>{node}</span></div> })}
          </div>
          <div class="stack-tags">{sys.stack.map((item) => <span>{item}</span>)}</div>
          <dl class="system-metrics">{sys.metrics.map(([value, label]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
          <p class="problem">{sys.problem}</p>
          {available("systems") ? <a class="case-link" href={`/systems/${sys.slug}/`}>Open case study & 2 live sandboxes <ArrowRight size={14} aria-hidden="true"/></a> : <span class="planned">Case study and two sandboxes planned</span>}
        </article>)}
      </div>
    </section>
    <MetricStrip metrics={profile.aggregateMetrics}/>
    <section class="principles" aria-labelledby="pillars-heading">
      <div class="section-heading"><h2 id="pillars-heading">Engineering principles</h2><span class="heading-rule"></span></div>
      <div class="pillar-grid">{profile.pillars.map((pillar, i) => {
        const Icon = [GitBranch, ScanLine, Braces][i]!;
        return <article><div class="pillar-icon"><Icon size={21} strokeWidth={1.6} aria-hidden="true"/><span>{pillar.index}</span></div><h3>{pillar.title}</h3><p>{pillar.summary}</p></article>;
      })}</div>
    </section>
    <section class="directory" aria-labelledby="directory-heading">
      <div class="section-heading"><h2 id="directory-heading">Operations kit directory</h2><span class="heading-rule"></span><ArrowDownRight size={20} aria-hidden="true"/></div>
      <div class="directory-list">{directory.map(({ path, name, count, detail, icon: Icon }) => {
        const live = available(path); const Tag = live ? "a" : "article";
        return <Tag class="directory-row" id={`directory-${path}`} href={live ? `/${path}/` : undefined}><Icon size={20} strokeWidth={1.6} aria-hidden="true"/><h3>{name} <span aria-label={`${Number(count)} entries`}>{count}</span></h3><p>{detail}</p>{live ? <ArrowUpRight size={17} aria-hidden="true"/> : <span class="planned">Planned</span>}</Tag>;
      })}</div>
    </section>
  </div>
</BaseLayout>
<style>
  .workbench { max-width: 1440px; padding: 0 clamp(1rem, 4.3vw, 4.5rem); margin: 0 auto; }
  .workbench-title, .availability, .sheet-count, .tabs button, .stack-tags span, .system-metrics dd, .planned, .locator, kbd, .directory-row h3 span, .pillar-icon span { font-family: var(--font-mono); }
  .workbench-title { display: flex; align-items: center; gap: .55rem; margin: clamp(1.35rem, 3vw, 2.6rem) 0 0; text-transform: uppercase; letter-spacing: .11em; font-size: .69rem; font-weight: 500; color: var(--ink-secondary); }
  .locator { color: var(--accent-primary); font-size: 1.35rem; line-height: 1; }
  .hero { display: grid; grid-template-columns: minmax(0, 1.22fr) minmax(0, 1fr); gap: clamp(2rem, 5.8vw, 7rem); align-items: center; padding-block: clamp(1.5rem, 3.9vw, 4rem); }
  .availability { display: inline-flex; gap: .42rem; align-items: flex-start; width: fit-content; max-width: 100%; border: 1px solid var(--border-hairline); border-radius: 2px; background: var(--accent-tint); color: var(--accent-primary); font-size: clamp(.56rem, .73vw, .65rem); font-weight: 600; letter-spacing: .035em; padding: .38rem .45rem; line-height: 1.5; }
  .availability :global(svg) { flex: none; margin-top: 1px; }
  h1 { margin: 1.05rem 0 .8rem; max-width: 10ch; font-size: clamp(4rem, 7.65vw, 7.25rem); line-height: 1.12; letter-spacing: -.025em; font-weight: 700; text-wrap: balance; }
  .role { margin: 0; font-size: clamp(1.1rem, 1.7vw, 1.65rem); line-height: 1.3; font-weight: 600; letter-spacing: -.035em; }
  .pitch { max-width: 60ch; margin: .95rem 0 1.35rem; color: var(--ink-secondary); line-height: 1.7; font-size: clamp(.87rem, 1.05vw, 1rem); }
  .hero-actions, .action, .search-hint, .switcher-head, .switcher-head strong, .case-link, .ownership, .section-heading, .stack-tags, .pillar-icon { display: flex; align-items: center; }
  .hero-actions { gap: .55rem; flex-wrap: wrap; }
  .action { gap: .7rem; border-radius: 4px; box-sizing: border-box; min-height: 42px; padding: .55rem .85rem; font-size: .79rem; font-weight: 700; text-decoration: none; }
  .primary { border: 1px solid var(--accent-primary); background: var(--accent-primary); color: var(--bg-surface); }
  .primary:hover { background: var(--accent-hover); }
  .secondary { border: 1px solid var(--border-strong); background: var(--bg-surface); color: var(--ink-primary); }
  .secondary:hover { border-color: var(--accent-primary); }
  .search-hint { border: 0; background: transparent; padding: .4rem 0; margin-top: .55rem; color: var(--ink-secondary); font-size: .72rem; gap: .4rem; cursor: pointer; }
  kbd { font-size: .62rem; border: 1px solid var(--border-strong); border-radius: 2px; padding: .07rem .22rem; }
  .switcher { border: 1px solid var(--border-strong); border-radius: 4px; overflow: clip; background: var(--bg-surface); scroll-margin-block-start: 6rem; }
  .switcher-head { justify-content: space-between; border-block-end: 1px solid var(--border-hairline); padding: .75rem 1.05rem; }
  .switcher-head strong { gap: .5rem; text-transform: uppercase; letter-spacing: .07em; font-size: .67rem; font-family: var(--font-mono); color: var(--ink-secondary); }
  .switcher-head :global(svg) { color: var(--accent-primary); }
  .sheet-count { font-size: .62rem; color: var(--ink-secondary); }
  .tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .tabs button { border: 0; border-radius: 0; border-inline-end: 1px solid var(--border-hairline); border-block-end: 1px solid var(--border-hairline); padding: .55rem .25rem; background: var(--bg-subtle); color: var(--ink-secondary); font-size: .64rem; cursor: pointer; font-weight: 500; line-height: 1.4; }
  .tabs button:last-child { border-inline-end: 0; }
  .tabs button[aria-selected="true"] { color: var(--accent-primary); background: var(--bg-surface); border-block-end: 2px solid var(--accent-primary); }
  .tabs button:focus-visible { outline-offset: -3px; }
  .panel { padding: clamp(.85rem, 1.8vw, 1.55rem); }
  .panel[hidden] { display: none; }
  .panel-title { display: flex; align-items: flex-start; justify-content: space-between; gap: .35rem; flex-wrap: wrap; }
  .panel h2 { margin: 0; font-size: clamp(1.15rem, 1.7vw, 1.6rem); }
  .ownership { gap: .3rem; border-radius: 2px; border: 1px solid var(--border-strong); padding: .15rem .38rem; font: 500 .64rem var(--font-mono); color: var(--ink-secondary); }
  .ownership.solo { background: var(--accent-tint); color: var(--accent-primary); border-color: var(--accent-primary); }
  .scope, .problem { margin: .45rem 0; color: var(--ink-secondary); font-size: .78rem; line-height: 1.5; }
  .diagram { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: start; background: var(--bg-subtle); border: 1px solid var(--border-hairline); border-radius: 2px; margin: 1rem 0 .65rem; padding: .85rem .4rem; }
  .diagram-node { position: relative; display: grid; justify-items: center; text-align: center; gap: .4rem; color: var(--ink-secondary); font: 500 .6rem var(--font-mono); }
  .diagram-node:not(:last-child)::after { position: absolute; top: 15px; inset-inline-start: calc(50% + 17px); content: ""; width: calc(100% - 34px); border-block-start: 1px solid var(--border-strong); }
  .symbol { width: 32px; height: 32px; display: grid; place-items: center; border: 1px solid var(--border-strong); border-radius: 3px; background: var(--bg-surface); color: var(--accent-primary); }
  .stack-tags { flex-wrap: wrap; gap: .35rem; }
  .stack-tags span { font-size: .61rem; padding: .13rem .35rem; border: 1px solid var(--border-hairline); border-radius: 2px; }
  .system-metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-block: 1px solid var(--border-hairline); margin: .8rem 0; padding-block: .55rem; }
  .system-metrics div { display: flex; flex-direction: column-reverse; gap: .1rem; padding-inline-start: .55rem; border-inline-start: 1px solid var(--border-hairline); }
  .system-metrics div:first-child { border-inline-start: 0; padding-inline-start: 0; }
  .system-metrics dt { font-size: .62rem; color: var(--ink-secondary); }
  .system-metrics dd { margin: 0; line-height: 1.25; font-size: 1.15rem; font-weight: 500; letter-spacing: -.07em; }
  .case-link { gap: .45rem; text-decoration: none; color: var(--accent-primary); font-size: .76rem; font-weight: 700; margin-top: .8rem; }
  .case-link:hover { text-decoration: underline; }
  .planned { font-size: .62rem; color: var(--ink-secondary); }
  .section-heading { gap: 1rem; margin-block: clamp(2.3rem, 5vw, 4.3rem) 1.15rem; }
  .section-heading h2 { font-size: clamp(1.5rem, 2.8vw, 2.5rem); margin: 0; }
  .heading-rule { flex: 1; border-top: 1px solid var(--border-strong); }
  .pillar-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(.85rem, 2.5vw, 2.5rem); }
  .pillar-grid article { border-block-start: 2px solid var(--accent-primary); padding: 1rem 0; }
  .pillar-icon { color: var(--accent-primary); justify-content: space-between; }
  .pillar-icon span { color: var(--ink-secondary); font-size: .7rem; }
  .pillar-grid h3 { font-size: clamp(1rem, 1.5vw, 1.25rem); margin: .85rem 0 .5rem; }
  .pillar-grid p, .directory-row p { color: var(--ink-secondary); font-size: .85rem; line-height: 1.6; margin: 0; }
  .directory-list { border-block-start: 1px solid var(--border-hairline); }
  .directory-row { color: var(--ink-primary); text-decoration: none; display: grid; grid-template-columns: 1.4rem minmax(12rem, 1fr) minmax(0, 1.5fr) auto; align-items: center; gap: 1rem; padding: .95rem .7rem; border-block-end: 1px solid var(--border-hairline); scroll-margin-block-start: 6rem; }
  a.directory-row:hover { background: var(--accent-tint); color: var(--accent-primary); }
  .directory-row > :global(svg:first-child) { color: var(--accent-primary); }
  .directory-row h3 { font-size: .95rem; margin: 0; }
  .directory-row h3 span { color: var(--ink-secondary); font-size: .67rem; margin-inline-start: .22rem; }
  .directory-row .planned { border: 1px dashed var(--border-strong); border-radius: 2px; padding: .1rem .3rem; }
  @media (min-width: 1700px) { .hero { gap: 7rem; } }
  @media (max-width: 890px) { .hero { grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 1.25rem; } h1 { font-size: clamp(3rem, 7.5vw, 5rem); } }
  @media (max-width: 720px) { .hero { grid-template-columns: 1fr; align-items: start; gap: 1.5rem; } .intro { padding-block: .5rem; } h1 { max-width: 14ch; font-size: clamp(3.3rem, 10.4vw, 4.8rem); } .pillar-grid { grid-template-columns: 1fr; gap: .45rem; } .pillar-grid article { padding: .85rem 0; } .directory-row { grid-template-columns: 1.25rem 1fr auto; gap: .3rem .65rem; padding-inline: 0; } .directory-row p { grid-column: 2 / 4; grid-row: 2; } .directory-row > :last-child { grid-column: 3; grid-row: 1; } }
  @media (prefers-reduced-motion: no-preference) { .action, .directory-row { transition: background-color 120ms ease, border-color 120ms ease; } }
</style>
