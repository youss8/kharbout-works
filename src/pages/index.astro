---
import { getCollection } from 'astro:content';
import {
    ArrowDown,
    ArrowRight,
    ArrowUpRight,
    BookOpen,
    Braces,
    CalendarDays,
    ChartNoAxesCombined,
    FlaskConical,
    Folders,
    GitBranch,
    Layers3,
    Mail,
    Network,
    Search,
    Workflow,
} from 'lucide-react';
import FeaturedWorkflows from '../components/demos/FeaturedWorkflows';
import { leaveDesk } from '../components/demos/hr-alpine.js';
import { kpiCockpit } from '../components/demos/portfolio-alpine.js';
import SystemExplorer from '../components/home/SystemExplorer.astro';
import BaseLayout from '../components/layout/BaseLayout.astro';
import { siteName } from '../data/brand';
import { skillGuides } from '../data/claude-skills';
import { labProjects } from '../data/lab';
import { profile } from '../data/profile';
import '../styles/home-assembly.css';

const [systems, vault, blueprints, templates] = await Promise.all([
    getCollection('systems'),
    getCollection('vault'),
    getCollection('ai-kit'),
    getCollection('templates'),
]);
const leave = leaveDesk();
const full = leave.priced;
leave.form.partOfDay = 'am';
const morning = leave.priced;
const kpi = kpiCockpit();
const pooled = kpi.result;
const pooledRate = kpi.show(pooled.actual);
kpi.method = 'naive';
const portfolio = '/systems/03-portfolio-kpi-engine/';
const hr = '/systems/02-hr-lifecycle-crm/';
const demos = [
    {
        title: 'KPI cockpit',
        text: 'Compare portfolio rollups',
        href: portfolio + '#kpi-cockpit',
        icon: ChartNoAxesCombined,
    },
    {
        title: 'Leave approval desk',
        text: 'Price and approve a request',
        href: hr + '#leave-engine',
        icon: CalendarDays,
    },
    {
        title: 'Funding flow',
        text: 'Trace funding by currency',
        href: portfolio + '#funding-flow',
        icon: GitBranch,
    },
    {
        title: 'Attendance & contracts',
        text: 'Review timesheets and signed terms',
        href: hr + '#attendance-amend',
        icon: Workflow,
    },
];
const resources = [
    {
        path: 'systems',
        name: 'System sandboxes',
        count: systems.reduce((sum, item) => sum + item.data.demoIds.length, 0),
        detail: 'Case studies and working demos',
        icon: Network,
    },
    {
        path: 'vault',
        name: 'Component vault',
        count: vault.length,
        detail: 'Reusable operational interfaces',
        icon: Layers3,
    },
    {
        path: 'ai-kit',
        name: 'AI engineering toolkit',
        count: blueprints.length,
        detail: 'Prompt blueprints and a builder',
        icon: Braces,
    },
    {
        path: 'claude-code-skills',
        name: 'Claude Code skills',
        count: skillGuides.length,
        detail: 'Guides, examples and agent support',
        icon: BookOpen,
    },
    {
        path: 'templates',
        name: 'Operations templates',
        count: templates.length,
        detail: 'Architecture and handover documents',
        icon: Folders,
    },
    {
        path: 'lab',
        name: 'R&D lab',
        count: labProjects.length,
        detail: 'Independent working prototypes',
        icon: FlaskConical,
    },
];
---

<BaseLayout
    title={profile.fullName}
    description={`${profile.fullName}’s engineering workbench with interactive system demos, reusable code, operations templates, and a CV.`}
>
    <noscript>
        <style is:inline>
            [data-workflow-controls] {
                display: none !important;
            }
        </style>
    </noscript>
    <div class="ha-home">
        <header class="ha-masthead" aria-labelledby="home-title">
            <div>
                <p class="ha-byline">
                    <i aria-hidden="true"></i>
                    {profile.fullName} <span>/ Engineering portfolio</span>
                </p>
                <h1 id="home-title">
                    Systems at work<span>.</span>
                </h1>
            </div>
            <div class="ha-intro">
                <p>
                    I design and build workflow software for portfolio tracking, HR and IT
                    operations.
                </p>
                <nav aria-label="Start exploring">
                    <a href="#featured-workflows">
                        Try a workflow <ArrowDown size={15} aria-hidden="true" />
                    </a>
                    <a href="/cv/">
                        Read my CV <ArrowUpRight size={15} aria-hidden="true" />
                    </a>
                </nav>
            </div>
        </header>

        <SystemExplorer />

        <section class="ha-workflow-section" aria-labelledby="ha-workflows">
            <div class="ha-workflow-intro">
                <h2 id="ha-workflows">
                    Try a workflow<span>.</span>
                </h2>
                <p>
                    Change an input and watch the calculation update. Open the full demo to trace
                    the rule behind the result.
                </p>
                <nav aria-label="Try a system demo" class="ha-demo-index">
                    {demos.map(({ title, text, href, icon: Icon }) => (
                        <a href={href}>
                            <Icon size={20} strokeWidth={1.6} aria-hidden="true" />
                            <span>
                                <b>{title}</b>
                                <small>{text}</small>
                            </span>
                            <ArrowUpRight size={16} aria-hidden="true" />
                        </a>
                    ))}
                </nav>
            </div>
            <FeaturedWorkflows
                client:load
                tracking={{
                    title: kpi.current.name,
                    indicator: kpi.selected,
                    pooled: {
                        value: pooledRate,
                        detail: `${pooled.numerator} of ${pooled.denominator} people across reporting sites`,
                    },
                    average: {
                        value: kpi.show(kpi.result.actual),
                        detail: 'Each reporting site receives equal weight, regardless of size.',
                    },
                    exclusions: kpi.exclusionNotes,
                    href: portfolio + '#kpi-cockpit',
                }}
                hr={{
                    full: { value: full.hours === null ? '—' : full.hours + 'h', days: full.days },
                    am: {
                        value: morning.hours === null ? '—' : morning.hours + 'h',
                        days: morning.days,
                    },
                    href: hr + '#leave-engine',
                }}
            />
        </section>

        <section class="ha-library" aria-labelledby="directory-heading">
            <div class="ha-section-head">
                <h2 id="directory-heading">
                    Workbench directory<span>.</span>
                </h2>
                <button type="button" data-ask-open aria-haspopup="dialog">
                    <Search size={16} aria-hidden="true" /> Search {siteName}
                </button>
            </div>
            <div class="ha-resource-list">
                {resources.map(({ path, name, count, detail, icon: Icon }) => (
                    <a href={'/' + path + '/'} id={'directory-' + path}>
                        <div>
                            <Icon size={22} strokeWidth={1.6} aria-hidden="true" />
                            <span aria-label={count + ' entries'}>
                                {String(count).padStart(2, '0')}
                            </span>
                        </div>
                        <h3>
                            {name}
                            <ArrowUpRight size={19} aria-hidden="true" />
                        </h3>
                        <p>{detail}</p>
                    </a>
                ))}
            </div>
        </section>

        <section class="ha-principles" aria-labelledby="pillars-heading">
            <div class="ha-section-head">
                <h2 id="pillars-heading">
                    Engineering principles<span>.</span>
                </h2>
            </div>
            <div>
                {profile.pillars.map((pillar) => (
                    <details>
                        <summary>
                            {pillar.title}
                            <span aria-hidden="true">+</span>
                        </summary>
                        <p>{pillar.summary}</p>
                    </details>
                ))}
            </div>
        </section>
        <aside class="ha-contact" aria-label="Career and contact">
            <span>
                {profile.availability.badge} · {profile.availability.location}
            </span>
            <a href={`mailto:${profile.contact.email}`}>
                <Mail size={15} aria-hidden="true" /> Get in touch{' '}
                <ArrowRight size={15} aria-hidden="true" />
            </a>
        </aside>
    </div>
</BaseLayout>
