---
import { ArrowRight, BookOpen, Search, Terminal } from 'lucide-react';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import { skillGroups, skillGuides, skillPath } from '../../data/claude-skills';
import '../../styles/workbench.css';
---
<BaseLayout title="Claude Code skills" description="Browse skill guides by task, check what each one requires and try a worked example prompt.">
    <div class="page-shell">
        <header class="intro">
            <div class="page-heading">
                <p class="section-id">07 / Skill directory</p>
                <h1>Claude Code skills</h1>
                <p>Find a skill for the task in front of you. Each guide lists the tools and inputs you need, a prompt to try, and a way to check the result.</p>
            </div>
            <aside class="setup" id="setup" aria-labelledby="setup-title">
                <h2 id="setup-title"><Terminal size={19} aria-hidden="true"/> Using a skill</h2>
                <p>Open the guide’s source for setup. For a project skill, place its complete folder in <code>.claude/skills/</code>. In Claude Code, type <kbd>/</kbd> to find its command, then adapt the example to your files.</p>
                <p>Collections can contain several commands. Cowork, connector and CLI guides list their own setup.</p>
                <a href="https://code.claude.com/docs/en/skills">Claude Code skill documentation</a>
            </aside>
        </header>

        <div class="directory" id="guides">
            <aside class="topics">
                <h2>Browse by category</h2>
                <nav aria-label="Skill categories">
                    <a href="#guides" data-topic="" aria-current="true">All guides <span>{skillGuides.length}</span></a>
                    {skillGroups.map(group =>
                        <a href={'?topic=' + group.id + '#' + group.id} data-topic={group.id}>{group.name} <span>{group.guides.length}</span></a>
                    )}
                </nav>
                <label class="mobile-topic">Category
                    <select id="topic-select">
                        <option value="">All guides ({skillGuides.length})</option>
                        {skillGroups.map(group => <option value={group.id}>{group.name} ({group.guides.length})</option>)}
                    </select>
                </label>
            </aside>
            <div class="results">
                <div id="search-tools" hidden>
                    <label for="guide-query">Search guides</label>
                    <div class="query-box"><Search size={18} aria-hidden="true"/><input id="guide-query" type="search" placeholder="Try PDF, React or brand voice" /></div>
                </div>
                <div class="result-meta">
                    <p role="status" id="count">{skillGuides.length} guides</p>
                    <button type="button" id="clear" hidden>Clear filters</button>
                </div>
                <p id="empty" hidden>No guides match these filters. Try another name or category.</p>
                {skillGroups.map(group => (
                    <section id={group.id} class="group" data-group={group.id} aria-labelledby={'title-' + group.id}>
                        <h2 id={'title-' + group.id}>{group.name}</h2>
                        <ul>
                            {group.guides.map(guide => (
                                <li data-aliases={[guide.slug, ...guide.aliases, guide.listing?.author, ...(guide.listing?.platforms ?? [])].join(' ')}>
                                    <a href={skillPath(guide.slug)}>
                                        <span class="guide-type"><BookOpen size={13} aria-hidden="true"/>{guide.kind}</span>
                                        <h3>{guide.name}</h3>
                                        <p>{guide.description}</p>
                                        <span class="state">{guide.toolCheck ? 'Tool checked · prompt planned' : 'Planned example'}</span>
                                        <ArrowRight className="directional-icon guide-arrow" size={16} aria-hidden="true"/>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </section>
                ))}
            </div>
        </div>
    </div>
</BaseLayout>
<script>
    const directory = document.querySelector<HTMLElement>('.directory')!;
    const query = document.querySelector<HTMLInputElement>('#guide-query')!;
    const select = document.querySelector<HTMLSelectElement>('#topic-select')!;
    const topics = [...directory.querySelectorAll<HTMLAnchorElement>('[data-topic]')];
    const count = document.getElementById('count')!;
    const empty = document.getElementById('empty')!;
    const clear = document.querySelector<HTMLButtonElement>('#clear')!;
    const normalize = (value: string) => value.toLowerCase().replace(/[^\p{L}\p{N}]+/gu, ' ').trim();
    const groups = [...directory.querySelectorAll<HTMLElement>('[data-group]')].map(section => ({
        section,
        rows: [...section.querySelectorAll('li')].map(row => ({
            row,
            text: normalize([section.querySelector('h2')?.textContent, row.dataset.aliases,
                row.querySelector('h3')?.textContent, row.querySelector('p')?.textContent,
                row.querySelector('.guide-type')?.textContent].join(' ')),
        })),
    }));

    function filter() {
        const terms = normalize(query.value).split(' ').filter(Boolean);
        let matches = 0;
        for (const { section, rows } of groups) {
            const inTopic = !select.value || section.dataset.group === select.value;
            let visible = 0;
            for (const { row, text } of rows) {
                row.hidden = !inTopic || !terms.every(term => text.includes(term));
                if (!row.hidden) visible++;
            }
            section.hidden = visible === 0;
            matches += visible;
        }
        for (const link of topics) {
            if (link.dataset.topic === select.value) link.setAttribute('aria-current', 'true');
            else link.removeAttribute('aria-current');
        }
        count.textContent = matches + (matches === 1 ? ' guide' : ' guides');
        empty.hidden = matches > 0;
        clear.hidden = !query.value && !select.value;
    }

    function save(push = false) {
        const url = new URL(location.href);
        for (const [key, value] of [['q', query.value], ['topic', select.value]]) {
            if (value) url.searchParams.set(key, value);
            else url.searchParams.delete(key);
        }
        url.hash = '';
        if (push) history.pushState(null, '', url);
        else history.replaceState(null, '', url);
        filter();
    }

    function restore() {
        const params = new URLSearchParams(location.search);
        query.value = params.get('q') ?? '';
        select.value = topics.find(link => link.dataset.topic === params.get('topic'))?.dataset.topic ?? '';
        filter();
    }

    for (const link of topics) {
        link.addEventListener('click', event => {
            if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
            event.preventDefault();
            select.value = link.dataset.topic ?? '';
            save(true);
            // A category link can be used after scrolling through a long topic.
            if (directory.getBoundingClientRect().top < 0) directory.scrollIntoView();
        });
    }
    select.addEventListener('change', () => save(true));
    query.addEventListener('input', () => save());
    clear.addEventListener('click', () => {
        query.value = '';
        select.value = '';
        save();
        query.focus();
    });
    window.addEventListener('popstate', restore);
    restore();
    document.getElementById('search-tools')!.hidden = false;
    directory.dataset.ready = 'true';
</script>
<style>
    .intro { display:grid; grid-template-columns:minmax(0,1.45fr) minmax(18rem,.75fr); align-items:center; gap:clamp(2rem,5vw,5rem); margin-block-end:clamp(2rem,4vw,4rem); }
    .page-heading { margin:0; }
    .setup { padding:1rem 1.2rem; background:var(--bg-subtle); border-inline-start:3px solid var(--accent-primary); }
    .setup h2 { display:flex; align-items:center; gap:.55rem; font-size:1rem; }
    .setup :global(svg), .setup a { color:var(--accent-primary); }
    .setup p, .setup a { font-size:.86rem; }
    .setup p { margin-block:.5rem; color:var(--ink-secondary); }
    .setup a, #clear { text-decoration:underline; text-underline-offset:.2em; }
    .directory { display:grid; grid-template-columns:minmax(12rem,15rem) minmax(0,1fr); gap:clamp(1.25rem,3.5vw,3.7rem); align-items:start; }
    .topics { position:sticky; inset-block-start:5.5rem; }
    .topics h2, #search-tools label, .mobile-topic { font-size:.88rem; font-weight:700; }
    .topics h2 { margin-block-end:.8rem; }
    .topics nav { display:grid; }
    .topics nav a { display:flex; align-items:center; justify-content:space-between; gap:.6rem; padding:.48rem .65rem; border-inline-start:2px solid transparent; font-size:.85rem; text-decoration:none; }
    .topics nav a:hover, .topics nav a[aria-current] { color:var(--accent-primary); background:var(--accent-tint); }
    .topics nav a[aria-current] { border-color:var(--accent-primary); font-weight:700; }
    .topics nav span, .result-meta, .guide-type, .state { color:var(--ink-secondary); font:500 .72rem/1.5 var(--font-mono); }
    .mobile-topic { display:none; }
    .results { min-width:0; }
    .query-box { display:flex; gap:.7rem; align-items:center; margin-block-start:.4rem; padding-inline:.85rem; border:1px solid var(--border-strong); border-radius:4px; background:var(--bg-surface); color:var(--ink-secondary); }
    .query-box:focus-within { outline:2px solid var(--accent-primary); outline-offset:2px; }
    .query-box input { border:none; outline:none; width:100%; min-width:0; padding:.7rem 0; background:transparent; color:var(--ink-primary); }
    .result-meta { display:flex; min-height:2.7rem; align-items:center; justify-content:space-between; }
    #clear { color:var(--accent-primary); }
    #empty { padding:1rem; background:var(--bg-subtle); }
    .group + .group { margin-block-start:2.2rem; }
    .group h2 { padding-block:.6rem .8rem; border-block-start:2px solid var(--accent-primary); font-size:clamp(1.3rem,2.3vw,1.9rem); }
    .group ul { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.7rem; padding:0; list-style:none; }
    .group li { display:flex; }
    .group li > a { position:relative; display:flex; flex-direction:column; align-items:flex-start; width:100%; padding:clamp(.9rem,1.5vw,1.25rem); border:1px solid var(--border-hairline); background:var(--bg-surface); text-decoration:none; }
    .group li > a:hover, .group li > a:focus-visible { border-color:var(--accent-primary); }
    .guide-type { display:flex; align-items:center; gap:.4rem; }
    .group h3 { margin-block:.45rem; font-size:1.04rem; overflow-wrap:anywhere; }
    .group p { margin-block-end:1rem; color:var(--ink-secondary); font-size:.86rem; }
    .state { margin-block-start:auto; font-size:.67rem; }
    .group :global(.guide-arrow) { position:absolute; inset-inline-end:1rem; inset-block-end:1rem; color:var(--accent-primary); }
    @media (max-width:800px) {
        .intro, .directory { grid-template-columns:minmax(0,1fr); gap:1.2rem; }
        .topics { position:static; }
        .directory[data-ready] .topics nav, .directory[data-ready] .topics h2 { display:none; }
        .directory[data-ready] .mobile-topic { display:grid; gap:.35rem; }
        select { padding:.5rem; border:1px solid var(--border-strong); border-radius:4px; color:var(--ink-primary); background:var(--bg-surface); }
    }
    @media (max-width:540px) { .group ul { grid-template-columns:minmax(0,1fr); } }
</style>
