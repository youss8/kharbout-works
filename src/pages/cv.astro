---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import BaseLayout from '../components/layout/BaseLayout.astro';
import StatusBadge from '../components/ui/StatusBadge.astro';
import SectionRail from '../components/ui/SectionRail.astro';
import { siteName } from '../data/brand';
import { profile } from '../data/profile';
import { sponsorScenario } from '../lib/operations-scenarios';
import '../styles/print-cv.css';

const { fullName, monogram, headline, contact, availability, coreStack } = profile;
const position = profile.experience[0];
const hasPortrait = existsSync(resolve('public', 'photo.jpg'));
const german = profile.languages.find(({ name }) => name === 'German');
const stackRows = [
    ['Languages', coreStack.languages],
    ['Backend & data', coreStack.backendAndData],
    ['Frontend & UX', coreStack.frontendAndUx],
    ['AI & quality', coreStack.aiAndQuality],
] as const;
const contacts = [
    { label: contact.email, href: 'mailto:' + contact.email },
    { label: 'github.com/' + contact.githubHandle, href: contact.github },
    {
        label:
            new URL(contact.linkedin).hostname.replace('www.', '') +
            new URL(contact.linkedin).pathname,
        href: contact.linkedin,
    },
    { label: siteName, href: contact.repoUrl },
];
const chapters: Array<[string, string]> = [
    ['hiring-brief', 'Hiring brief'],
    ['career-focus', 'Career focus'],
    ['technical-stack', 'Technical stack'],
    ['experience', 'Experience'],
    ['education', 'Education & certifications'],
    ['languages', 'Languages'],
    ['leadership', 'Leadership'],
];
const projectEvidence = [
    {
        name: 'Portfolio and funding',
        scope: 'Primary architect and builder of roughly 80% on a three-developer team.',
        label: 'Run the sponsor reporting scenario',
        href: sponsorScenario,
    },
    {
        name: 'HR lifecycle',
        scope: 'Core contributor and co-architect on the three-developer pre-RMS team.',
        label: 'Try the leave pricing and approval rules',
        href: '/systems/02-hr-lifecycle-crm/#leave-engine',
    },
    {
        name: 'IT operations',
        scope: 'Solo architect and builder. Architecture-verified, with fleet rollout held.',
        label: 'Inspect the endpoint monitor',
        href: '/systems/01-it-ops-helpdesk/#estate-overview',
    },
];
---

<BaseLayout
    title={`CV · ${fullName}`}
    description={`${fullName} · ${headline}. International and DACH CV, available ${availability.month}.`}
>
    <div
        class="cv-page"
        x-data={`{ dach: false, employer: ${JSON.stringify(position.defaultOrgLabel)} }`}
    >
        <div class="cv-reader">
            <SectionRail links={chapters} label="CV sections" heading="In this CV" />
            <article class="cv-sheet" aria-label={`Curriculum vitae of ${fullName}`}>
                <header class="cv-masthead">
                    <div>
                        <p class="cv-kicker">Curriculum vitae</p>
                        <h1>{fullName}</h1>
                        <p class="cv-headline">{headline}</p>
                        <address class="cv-contacts">
                            <span>{availability.location}</span>
                            {contacts.map(({ label, href }) => (
                                <a href={href}>{label}</a>
                            ))}
                        </address>
                    </div>
                    <div class="cv-portrait" x-show="dach" x-cloak>
                        {hasPortrait ? (
                            <img
                                src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/photo.jpg`}
                                alt={fullName}
                                width="96"
                                height="116"
                            />
                        ) : (
                            <span aria-label={`Initials of ${fullName}`}>{monogram}</span>
                        )}
                    </div>
                </header>
                <section
                    class="cv-brief no-print"
                    id="hiring-brief"
                    aria-labelledby="brief-title"
                    tabindex="-1"
                >
                    <div class="cv-brief-header">
                        <div>
                            <h2 id="brief-title">Hiring brief</h2>
                            <p>
                                Available from {availability.month} · {availability.mobility}
                            </p>
                        </div>
                        <nav aria-label="Download public CV">
                            <a href="/cv-international.pdf" download>
                                International CV (PDF)
                            </a>
                            <a href="/cv-dach.pdf" download>
                                DACH CV (PDF)
                            </a>
                        </nav>
                    </div>
                    <ul>
                        {projectEvidence.map(({ name, scope, label, href }) => (
                            <li>
                                <h3>{name}</h3>
                                <p>{scope}</p>
                                <a href={href}>
                                    {label} <span aria-hidden="true">↗</span>
                                </a>
                            </li>
                        ))}
                    </ul>
                </section>
                <p class="cv-relocation" x-show="dach" x-cloak>
                    {availability.relocation}
                    {german &&
                        ` · ${german.name} ${german.cefr} ${german.level.match(/\(.+\)/)?.[0] ?? ''}`}
                </p>

                <div class="cv-toolbar no-print" aria-label="CV settings">
                    <fieldset class="cv-fieldset">
                        <legend>CV format</legend>
                        <div class="cv-formats">
                            <button
                                type="button"
                                aria-pressed="true"
                                x-bind:aria-pressed="!dach"
                                x-on:click="dach = false"
                            >
                                International / Remote Tech
                            </button>
                            <button
                                type="button"
                                aria-pressed="false"
                                x-bind:aria-pressed="dach"
                                x-on:click="dach = true"
                            >
                                DACH / Germany
                            </button>
                        </div>
                    </fieldset>
                    <label class="cv-employer-setting" for="cv-employer">
                        Employer for private PDF
                        <input
                            id="cv-employer"
                            name="cv-employer"
                            type="text"
                            autocomplete="off"
                            value={position.defaultOrgLabel}
                            x-model="employer"
                        />
                    </label>
                    <button type="button" class="cv-print" x-on:click="window.print()">
                        <svg
                            aria-hidden="true"
                            width="17"
                            height="17"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.6"
                            stroke-linejoin="round"
                        >
                            <path d="M7 8V3h10v5M7 17H4V8h16v9h-3" />
                            <path d="M7 14h10v7H7zM16 11h1" />
                        </svg>
                        Print / Save PDF
                    </button>
                </div>

                <section class="cv-section cv-focus" id="career-focus" tabindex="-1">
                    <h2>Career focus</h2>
                    <div>
                        <p>{availability.careerFocus}</p>
                        <p class="cv-available">
                            <StatusBadge label={availability.badge} shape="surface" tone="ok" />
                        </p>
                    </div>
                </section>
                <section class="cv-section" id="technical-stack" tabindex="-1">
                    <h2>Technical stack</h2>
                    <dl class="cv-stack">
                        {stackRows.map(([label, tools]) => (
                            <div>
                                <dt>{label}</dt>
                                <dd>{tools.join(' · ')}</dd>
                            </div>
                        ))}
                    </dl>
                </section>
                <section class="cv-section cv-experience" id="experience" tabindex="-1">
                    <h2>Professional experience</h2>
                    <div>
                        <p class="cv-period">{position.period}</p>
                        <h3>{position.role}</h3>
                        <p
                            class="cv-employer"
                            x-text={`employer.trim() || ${JSON.stringify(position.defaultOrgLabel)}`}
                        >
                            {position.defaultOrgLabel}
                        </p>
                        <p class="cv-job-location">{position.location}</p>
                        <p>
                            Across all three platforms ·{' '}
                            {profile.aggregateMetrics
                                .slice(0, 3)
                                .map(({ value, label }) => `${value} ${label.toLowerCase()}`)
                                .join(' · ')}
                        </p>
                        <ul class="cv-projects">
                            {position.highlights.map((highlight) => (
                                <li>{highlight}</li>
                            ))}
                        </ul>
                        <a class="cv-evidence no-print" href="/systems/">
                            Explore the systems behind this experience{' '}
                            <span aria-hidden="true">↗</span>
                        </a>
                    </div>
                </section>
                <section class="cv-section" id="education" tabindex="-1">
                    <h2>Education & certifications</h2>
                    <div>
                        {profile.education.map(({ degree, institution, details }) => (
                            <p>
                                <strong>{degree}</strong> — {institution} ({details})
                            </p>
                        ))}
                        <ul class="cv-credentials">
                            {profile.certifications.map(({ name, issuer }) => (
                                <li>
                                    {name} <span>· {issuer}</span>
                                </li>
                            ))}
                        </ul>
                    </div>
                </section>
                <section class="cv-section" id="languages" tabindex="-1">
                    <h2>Languages</h2>
                    <dl class="cv-languages">
                        {profile.languages.map(({ name, level }) => (
                            <div>
                                <dt>{name}</dt>
                                <dd>{level}</dd>
                            </div>
                        ))}
                    </dl>
                </section>
                <section class="cv-section cv-leadership" id="leadership" tabindex="-1">
                    <h2>Leadership & mentorship</h2>
                    <div>
                        {profile.leadership.sections.map((line) => (
                            <p>{line}</p>
                        ))}
                    </div>
                </section>
            </article>
        </div>
    </div>
</BaseLayout>
<style>
    @media screen {
        .cv-brief {
            margin-block: 1.45rem;
            border-block: 1px solid var(--border-hairline);
        }
        .cv-brief-header {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 0.5rem 1.25rem;
            padding-block: 0.9rem;
        }
        .cv-brief-header p,
        .cv-brief li p {
            color: var(--ink-secondary);
        }
        .cv-brief nav {
            display: flex;
            flex-wrap: wrap;
            gap: 0 1rem;
        }
        .cv-brief a {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            min-block-size: 44px;
            color: var(--accent-primary);
            text-underline-offset: 0.2em;
        }
        .cv-brief ul {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
            padding: 0;
            gap: 1px;
            background: var(--border-hairline);
            border-block-start: 1px solid var(--border-hairline);
            list-style: none;
        }
        .cv-brief li {
            padding: 0.75rem;
            background: var(--bg-surface);
        }
        .cv-brief li h3 {
            margin-block-end: 0.35rem;
        }
        .cv-page {
            width: min(1440px, 100%);
            padding-inline: var(--page-gutter, clamp(1rem, 4vw, 4rem));
        }
        .cv-reader {
            display: grid;
            grid-template-columns: minmax(10rem, 0.6fr) minmax(0, 2.7fr);
            align-items: start;
            gap: clamp(1rem, 3.8vw, 3.8rem);
        }
        .cv-sheet {
            border: 1px solid var(--border-hairline);
            border-block-start: 0.36rem solid var(--assembly-blue);
            padding: clamp(1.2rem, 3.9vw, 3.8rem);
        }
        .cv-sheet h1 {
            font-family: var(--font-display);
            font-weight: 750;
            line-height: 1.02;
        }
        .cv-kicker {
            color: var(--accent-primary);
        }
        .cv-toolbar {
            background: var(--bg-subtle);
            border: 0;
            border-block: 1px solid var(--border-hairline);
            border-radius: 0;
            margin: 1.4rem 0 0;
            padding: 0.95rem;
            gap: 0.75rem 1rem;
        }
        .cv-toolbar :is(button, input) {
            min-height: 44px;
            border-radius: 0;
        }
        .cv-toolbar .cv-print {
            color: #fff;
            background: var(--assembly-blue);
            border-color: var(--assembly-blue);
        }
        .cv-sheet .cv-section {
            grid-template-columns: minmax(8rem, 0.9fr) minmax(0, 2.7fr);
        }
        .cv-evidence {
            display: inline-flex;
            gap: 0.5rem;
            min-height: 44px;
            align-items: center;
            color: var(--accent-primary);
            font-weight: 650;
            margin-block-start: 0.7rem;
        }
    }
    @media screen and (max-width: 850px) {
        .cv-reader {
            grid-template-columns: 1fr;
        }
        .cv-reader :global(.section-rail) {
            display: flex;
            flex-wrap: nowrap;
            align-items: center;
            overflow-x: auto;
            padding: 0.2rem;
            gap: 0.25rem 0.4rem;
        }
        .cv-reader :global(.section-rail > *) {
            flex: none;
            white-space: nowrap;
            width: auto;
        }
        .cv-reader :global(.section-rail p) {
            margin: 0;
        }
    }
    @media screen and (max-width: 700px) {
        .cv-sheet .cv-section {
            grid-template-columns: 1fr;
        }
    }
</style>
