---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import CodeTabs from '../../components/ui/CodeTabs.astro';
import '../../styles/workbench.css';
const items = (await getCollection('vault')).sort((a,b) => a.data.order-b.data.order);
const categories = [...new Set(items.map(item => item.data.category))];
---
<BaseLayout title="Dual-stack component vault">
    <div class="page-shell"><header class="page-heading"><p class="section-id">02 / Vault</p><h1>Component vault</h1><p>Test an operational interface, change its viewport or direction, and take the implementation into your stack.</p></header>
        <component-vault>
            <aside class="vault-register">
                <label>Search patterns<input type="search" placeholder="Name, behavior or system" /></label>
                <fieldset><legend>Category</legend><div class="pills">{['', ...categories].map(category => <button type="button" data-category-filter={category} aria-pressed={category === '' ? 'true' : 'false'}>{category || 'All'}</button>)}</div></fieldset>
                <nav aria-label="Component patterns">
                    {items.map(item => <a href={'#'+item.id} data-id={item.id} data-category={item.data.category} data-keywords={[item.data.title,item.data.category,item.data.sourceSystem,item.data.summary,...item.data.interactionSpecs].join(' ').toLowerCase()}>
                        <span>{item.data.title}</span><small>{item.data.category}</small></a>)}
                </nav>
            </aside>
            <div class="vault-detail">
                <p role="status" class="empty" hidden>No matching patterns. <button type="button" data-clear>Clear filters</button></p>
                {items.map((item,i) => <article id={item.id} hidden={i!==0}>
                    <p class="section-id">{item.data.sourceSystem} / {item.data.category}</p><h2>{item.data.title}</h2><p>{item.data.summary}</p>
                    <CodeTabs item={item}/>
                </article>)}
            </div>
        </component-vault>
    </div>
</BaseLayout>
<script>
    class ComponentVault extends HTMLElement {
        connectedCallback() {
            const links = [...this.querySelectorAll<HTMLAnchorElement>('nav a')];
            const articles = [...this.querySelectorAll<HTMLElement>('.vault-detail article')];
            const query = this.querySelector('input')!;
            const pills = [...this.querySelectorAll<HTMLButtonElement>('[data-category-filter]')];
            let category = '';
            const empty = this.querySelector<HTMLElement>('.empty')!;
            const select = (id: string) => {
                links.forEach(link => {
                    if (link.dataset.id === id) link.setAttribute('aria-current','true'); else link.removeAttribute('aria-current');
                });
                articles.forEach(article => {
                    article.hidden = article.id !== id;
                    if (!article.hidden) article.querySelector('vault-frame')?.dispatchEvent(new Event('activate-preview'));
                });
            };
            const filter = () => {
                pills.forEach(pill => pill.setAttribute('aria-pressed', String(pill.dataset.categoryFilter === category)));
                links.forEach(link => { link.hidden = !!(category && link.dataset.category !== category) || !link.dataset.keywords!.includes(query.value.trim().toLowerCase()); });
                const match = links.find(link => !link.hidden && link.hash === location.hash) ?? links.find(link => !link.hidden);
                empty.hidden = !!match;
                select(match?.dataset.id ?? '');
            };
            query.addEventListener('input', filter);
            pills.forEach(pill => pill.addEventListener('click', () => { category = pill.dataset.categoryFilter!; filter(); }));
            this.querySelector('[data-clear]')!.addEventListener('click', () => { query.value=''; category=''; filter(); query.focus(); });
            window.addEventListener('hashchange', filter);
            links.forEach(link => link.addEventListener('click', event => {
                event.preventDefault();
                if (location.hash !== link.hash) history.pushState(null,'',link.hash);
                select(link.dataset.id!);
                if (matchMedia('(max-width: 760px)').matches) document.getElementById(link.dataset.id!)?.scrollIntoView();
            }));
            filter();
        }
    }
    customElements.define('component-vault', ComponentVault);
</script>
<style>
    component-vault { display:grid; grid-template-columns:minmax(14rem,19rem) minmax(0,1fr); gap:clamp(1rem,3vw,2.5rem); }
    .vault-register { align-self:start; border:1px solid var(--border-hairline); background:var(--bg-surface); padding:1rem; border-top:3px solid var(--accent-primary); }
    label { display:grid; gap:.25rem; margin-bottom:.75rem; font-size:.84rem; font-weight:600; }
    input,select { width:100%; background:var(--bg-canvas); border:1px solid var(--border-strong); padding:.5rem; border-radius:3px; }
    fieldset { margin: .6rem 0 1rem; } legend { font-weight: 600; font-size: .84rem; }
    .pills { display: flex; flex-wrap: wrap; gap: .28rem; margin-top:.35rem; }
    .pills button { border:1px solid var(--border-hairline); padding:.25rem .45rem; font-size:.75rem; border-radius:3px; }
    .pills button[aria-pressed="true"] { border-color:var(--accent-primary); background:var(--accent-tint); color:var(--accent-primary); }
    nav { display:grid; } nav a { padding:.65rem .5rem; border-top:1px solid var(--border-hairline); font-size:.9rem; line-height:1.3; font-weight:600; }
    nav a[aria-current] { border-inline-start:3px solid var(--accent-primary); background:var(--accent-tint); color:var(--accent-primary); }
    small { display:block; font:.68rem var(--font-mono); color:var(--ink-secondary); margin-top:.25rem; }
    .vault-detail { min-width:0; }
    article,.empty { background:var(--bg-surface); border:1px solid var(--border-hairline); padding:clamp(.75rem,2vw,1.7rem); }
    article h2 { font-size:clamp(1.6rem,2.7vw,2.6rem); margin-block:.55rem; font-weight:600; }
    [data-clear] { text-decoration:underline; color:var(--accent-primary); }
    @media (max-width:760px) { component-vault { grid-template-columns:1fr; } nav { max-height:15rem; overflow:auto; } }
</style>
