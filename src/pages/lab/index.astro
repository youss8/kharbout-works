---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import StatusBadge from '../../components/ui/StatusBadge.astro';
import WorkbenchPicker from '../../components/ui/WorkbenchPicker.astro';
import DatePlanner from '../../components/lab/DatePlanner.astro';
import HabitTracker from '../../components/lab/HabitTracker.astro';
import LandingStudy from '../../components/lab/LandingStudy.astro';
import MealConfigurator from '../../components/lab/MealConfigurator.astro';
import { labProjects } from '../../data/lab';
import '../../styles/workbench.css';
const demos = {
    'date-planner': DatePlanner,
    'habit-tracker': HabitTracker,
    'landing-redesign': LandingStudy,
    'meal-configurator': MealConfigurator,
};
const projectActions: Record<string, string> = {
    'date-planner': 'Build an itinerary',
    'habit-tracker': 'Track a habit',
    'landing-redesign': 'Compare landing pages',
    'meal-configurator': 'Configure a meal',
};
const choices = labProjects.map(({ id, title }) => ({ id, label: projectActions[id] ?? title }));
---

<BaseLayout title="R&D lab">
    <div class="page-shell lab-page">
        <header class="page-heading lab-intro">
            <h1>R&amp;D lab</h1>
            <p>
                Four personal, unshipped prototypes. Try the interaction behind each product idea.
            </p>
        </header>
        <WorkbenchPicker label="Choose a prototype" items={choices}>
            <div class="lab-grid">
                {labProjects.map((project) => {
                    const Demo = demos[project.id as keyof typeof demos];
                    return (
                        <article id={project.id} data-picker-panel tabindex="-1">
                            <header>
                                <StatusBadge label="Prototype · R&D Build" shape="dashed" />
                                <h2>{project.title}</h2>
                                <p>{project.summary}</p>
                                {project.repoUrl && <a href={project.repoUrl}>Source repository</a>}
                                {project.liveUrl && (
                                    <a href={project.liveUrl}>Open standalone prototype</a>
                                )}
                                {project.screenshot && (
                                    <img
                                        src={project.screenshot}
                                        loading="lazy"
                                        alt={project.title + ' interface'}
                                    />
                                )}
                            </header>
                            {Demo && <Demo />}
                        </article>
                    );
                })}
            </div>
        </WorkbenchPicker>
    </div>
</BaseLayout>
<style is:global>
    .lab-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: clamp(1rem, 2vw, 2rem);
        align-items: start;
    }
    .lab-grid article {
        background: var(--bg-surface);
        border: 1px solid var(--border-hairline);
        border-block-start: 0;
        min-width: 0;
    }
    .lab-grid article > header,
    .lab-demo {
        padding: clamp(1rem, 2vw, 1.7rem);
    }
    .lab-intro {
        border-bottom: 2px solid var(--ink-primary);
        padding-block-end: clamp(1.25rem, 3vw, 2.6rem);
        max-inline-size: none;
    }
    .lab-intro h1 {
        font-family: var(--font-display);
    }
    .lab-grid article > header {
        color: #fff;
        background: var(--assembly-blue);
    }
    .lab-grid article > header p {
        color: #eef3ff;
    }
    .lab-grid article > header .status-badge {
        color: var(--assembly-lime);
        border: 0;
        padding: 0;
    }
    .lab-grid article > header .status-badge > span[aria-hidden] {
        display: none;
    }
    .lab-grid article > header h2 {
        font: 700 clamp(1.75rem, 3.6vw, 3.6rem)/1.02 var(--font-display);
        letter-spacing: -0.055em;
    }
    .lab-grid article > header a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        color: #fff;
        text-decoration: underline;
    }
    .lab-note {
        color: var(--ink-secondary);
        font-size: 0.9rem;
    }
    .lab-grid h2 {
        font-weight: 600;
        font-size: clamp(1.4rem, 2.2vw, 2.15rem);
        margin: 0.7rem 0 0.45rem;
    }
    .lab-demo {
        border-block-start: 1px solid var(--border-hairline);
        font-size: 0.92rem;
    }
    .lab-demo fieldset {
        margin-block-end: 1rem;
    }
    .lab-demo legend,
    .lab-demo label {
        font-weight: 600;
    }
    .lab-demo :is(input, select, button) {
        border: 1px solid var(--border-strong);
        background: var(--bg-surface);
        color: var(--ink-primary);
        border-radius: 3px;
        padding: 0.48rem 0.65rem;
    }
    .lab-demo button {
        font-size: 0.85rem;
        font-weight: 600;
    }
    .lab-demo button[aria-pressed='true'] {
        background: var(--accent-tint);
        color: var(--accent-primary);
        border-color: var(--accent-primary);
    }
    .lab-demo button.lab-primary {
        background: var(--accent-primary);
        color: var(--bg-surface);
        border-color: var(--accent-primary);
    }
    .demo-label {
        color: var(--ink-secondary);
        font: 500 0.78rem/1.5 var(--font-mono);
        margin: 0 0 0.65rem;
    }
    .lab-demo .choices {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin: 0.5rem 0;
    }
    .lab-fields {
        display: grid;
        gap: 0.65rem;
        grid-template-columns: repeat(auto-fit, minmax(min(9rem, 100%), 1fr));
        margin-block-end: 0.8rem;
    }
    .lab-fields label,
    .lab-head label {
        display: grid;
        gap: 0.28rem;
        font-size: 0.81rem;
    }
    .lab-check {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        margin: 0.8rem 0;
    }
    .lab-result {
        font: 600 0.94rem/1.5 var(--font-mono);
        background: var(--accent-tint);
        color: var(--accent-primary);
        padding: 0.6rem 0.8rem;
    }
    .itinerary li {
        display: grid;
        grid-template-columns: auto 1fr;
        column-gap: 0.6rem;
        padding: 0.65rem 0;
        border-block-end: 1px solid var(--border-hairline);
    }
    .itinerary li span {
        grid-column: 2;
    }
    .lab-head {
        display: flex;
        align-items: end;
        gap: 1rem;
        justify-content: space-between;
        margin-block-end: 1rem;
    }
    .heatmap {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 0.25rem;
        margin-block-end: 1rem;
    }
    .heatmap button {
        display: grid;
        place-items: center;
        padding: 0.25rem;
        font: 500 0.8rem var(--font-mono);
    }
    .heatmap button[aria-pressed='true'] {
        background: var(--accent-primary);
        color: var(--bg-surface);
    }
    .landing-sample {
        padding: 1.2rem;
        background: var(--bg-subtle);
        border: 1px solid var(--border-hairline);
        margin: 0.85rem 0;
    }
    .landing-sample h3 {
        font-size: clamp(1.25rem, 2.2vw, 2rem);
        font-weight: 600;
        line-height: 1.12;
        margin-block-end: 0.65rem;
    }
    .landing-sample button {
        margin-block-start: 0.9rem;
    }
    .landing-sample[data-variant='Original'] {
        text-align: center;
    }
    .landing-sample[data-variant='Original'] h3 {
        font-size: 1.1rem;
        margin: 0.85rem;
    }
    .landing-sample[data-variant='Original'] button {
        background: var(--bg-surface);
        color: var(--ink-primary);
    }
    .landing-sample ol {
        margin-block-start: 0.85rem;
        padding-inline-start: 1.25rem;
        list-style: decimal;
    }
    .topping {
        display: flex;
        gap: 0.5rem;
        padding: 0.5rem 0;
        border-block-end: 1px solid var(--border-hairline);
        align-items: center;
    }
    .topping small {
        margin-inline-start: auto;
        font: 500 0.75rem var(--font-mono);
    }
    .lab-note {
        margin-block-start: 0.8rem;
    }
</style>
