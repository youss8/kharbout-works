---
import { ArrowUpRight, ArrowRight, ArrowUp } from 'lucide-react';
import { siteName } from '../../data/brand';
import { profile } from '../../data/profile';

const [area, entry] = Astro.url.pathname.split('/').filter(Boolean);
const destinations: Record<string, [string, string]> = {
    systems: entry
        ? ['Explore the component vault', '/vault/']
        : ['Try the prototype lab', '/lab/'],
    vault: ['See the systems behind the kits', '/systems/'],
    'ai-kit': ['Find a skill for your task', '/claude-code-skills/'],
    'claude-code-skills': ['Explore the AI toolkit', '/ai-kit/'],
    templates: ['Explore the component vault', '/vault/'],
    lab: ['Explore the system demos', '/systems/'],
    cv: ['See the engineering case studies', '/systems/'],
};
const next = destinations[area] ?? ['Explore the component vault', '/vault/'];
---

<footer class="site-footer no-print">
    <div class="footer-shell">
        <nav class="next" aria-label="Continue exploring">
            <a href={next[1]}>
                {next[0]} <ArrowRight className="directional-icon" size={27} aria-hidden="true" />
            </a>
        </nav>
        <nav class="contacts" aria-label="Contact and source">
            <a href={'mailto:' + profile.contact.email}>
                Email <ArrowUpRight size={14} aria-hidden="true" />
            </a>
            <a href={profile.contact.github}>
                GitHub <ArrowUpRight size={14} aria-hidden="true" />
            </a>
            <a href={profile.contact.linkedin}>
                LinkedIn <ArrowUpRight size={14} aria-hidden="true" />
            </a>
        </nav>
        <div class="credits">
            <a class="signature" href="/">
                {siteName}
            </a>
            <a href={profile.contact.repoUrl + '/blob/main/LICENSE'}>MIT License</a>
            <a class="back" href="#page-top">
                Back to top <ArrowUp size={14} aria-hidden="true" />
            </a>
        </div>
    </div>
</footer>
<style>
    .site-footer {
        margin-block-start: clamp(3rem, 6vw, 6rem);
        background: #10151d;
        color: #f4f7fa;
    }
    .footer-shell {
        max-width: 1580px;
        margin: auto;
        padding: clamp(2rem, 5vw, 4.8rem) var(--page-gutter) 1.2rem;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 2rem;
    }
    a {
        color: inherit;
        text-decoration: none;
    }
    a:focus-visible {
        outline-color: var(--assembly-lime);
    }
    .next a {
        display: inline-flex;
        align-items: center;
        gap: clamp(1rem, 2vw, 2rem);
        max-inline-size: 19ch;
        font: 650 clamp(1.8rem, 3.5vw, 3.9rem)/1.04 var(--font-display);
        letter-spacing: -0.055em;
    }
    .next :global(svg) {
        flex: none;
        color: var(--assembly-lime);
        transition: translate 0.2s ease;
    }
    .next a:hover :global(svg) {
        translate: 5px 0;
    }
    .contacts,
    .credits {
        display: flex;
        gap: 0.5rem 1.3rem;
        align-items: center;
        flex-wrap: wrap;
    }
    .contacts a,
    .credits a {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        min-height: 44px;
    }
    .contacts a:hover,
    .credits a:hover {
        text-decoration: underline;
        text-underline-offset: 0.25em;
    }
    .contacts {
        align-self: center;
        font-size: 0.92rem;
    }
    .credits {
        grid-column: 1/-1;
        border-block-start: 1px solid #414956;
        padding-block-start: 0.75rem;
        margin-block-start: 1rem;
        color: #c4cdd6;
        font-size: 0.8rem;
    }
    .signature {
        font: 700 1.05rem/1 var(--font-display);
        letter-spacing: -0.045em;
        color: #fff;
    }
    .back {
        margin-inline-start: auto;
    }
    @media (max-width: 700px) {
        .footer-shell {
            grid-template-columns: 1fr;
            gap: 1rem;
        }
        .credits {
            margin-block-start: 0;
        }
    }
    @media print {
        .site-footer {
            display: none !important;
        }
    }
</style>
