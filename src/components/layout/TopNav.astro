---
import {
    ArrowUpRight,
    Blocks,
    BookOpen,
    Boxes,
    ChevronDown,
    FileText,
    FlaskConical,
    FolderOpen,
    Layers3,
    Mail,
    Menu,
    Moon,
    Search,
    Sun,
    X,
} from 'lucide-react';
import { siteName } from '../../data/brand';
import { profile } from '../../data/profile';

const sections = [
    {
        label: 'Systems',
        slug: 'systems',
        description: 'Case studies and working demos',
        icon: Layers3,
    },
    {
        label: 'Vault',
        slug: 'vault',
        description: 'Components with live previews and source',
        icon: Blocks,
    },
    { label: 'AI Kit', slug: 'ai-kit', description: 'Build, test and export prompts', icon: Boxes },
    {
        label: 'Skills',
        slug: 'claude-code-skills',
        description: 'Find an agent skill by task',
        icon: BookOpen,
    },
    {
        label: 'Templates',
        slug: 'templates',
        description: 'Architecture and operations documents',
        icon: FolderOpen,
    },
    { label: 'Lab', slug: 'lab', description: 'Try the personal prototypes', icon: FlaskConical },
    { label: 'CV', slug: 'cv', description: 'Experience and printable profiles', icon: FileText },
];
const [systems, ...remaining] = sections;
const resources = remaining.slice(0, 4);
const personal = remaining.slice(4);
const current = Astro.url.pathname.split('/')[1];
const isResource = resources.some((section) => section.slug === current);
const href = (slug: string) => '/' + slug + '/';
---

<header class="site-header no-print">
    <div class="nav-shell">
        <a class="brand" href="/" aria-label={siteName + ' home'}>
            <img src="/favicon.svg" width="34" height="34" alt="" />
            <bdi dir="ltr">{siteName}</bdi>
        </a>
        <nav class="desktop-links" aria-label="Primary navigation">
            <a
                class="nav-link"
                href={href(systems.slug)}
                aria-current={current === systems.slug ? 'page' : undefined}
            >
                Systems
            </a>
            <details class="resource-menu" data-resource-menu>
                <summary class:list={['nav-link', { 'resource-current': isResource }]}>
                    Resources <ChevronDown size={14} aria-hidden="true" />
                </summary>
                <div class="resource-pane">
                    {resources.map(({ label, slug, description, icon: Icon }) => (
                        <a href={href(slug)} aria-current={current === slug ? 'page' : undefined}>
                            <Icon size={20} aria-hidden="true" />
                            <span>
                                <strong>{label}</strong>
                                <small>{description}</small>
                            </span>
                        </a>
                    ))}
                </div>
            </details>
            {personal.map(({ label, slug }) => (
                <a
                    class="nav-link"
                    href={href(slug)}
                    aria-current={current === slug ? 'page' : undefined}
                >
                    {label}
                </a>
            ))}
        </nav>
        <div class="utilities">
            <button
                class="search-button"
                type="button"
                aria-label="Open command search"
                title="Search (Ctrl+K or Cmd+K)"
                aria-keyshortcuts="Control+K Meta+K"
                aria-haspopup="dialog"
                data-ask-open
            >
                <Search size={16} aria-hidden="true" />
                <span>Search</span>
                <kbd aria-hidden="true" data-search-key>
                    Ctrl K
                </kbd>
            </button>
            <button
                class="icon-button theme"
                type="button"
                aria-label="Dark mode"
                aria-pressed="false"
                title="Toggle dark mode"
                data-theme-toggle
            >
                <Moon className="moon-icon" size={18} aria-hidden="true" />
                <Sun className="sun-icon" size={18} aria-hidden="true" />
            </button>
            <a class="contact" href={'mailto:' + profile.contact.email}>
                Get in touch <ArrowUpRight size={15} aria-hidden="true" />
            </a>
            <button
                class="icon-button menu-trigger"
                type="button"
                aria-label="Open navigation"
                aria-haspopup="dialog"
                aria-expanded="false"
                aria-controls="mobile-nav"
                data-menu-open
            >
                <Menu size={21} aria-hidden="true" />
            </button>
        </div>
    </div>
    <dialog id="mobile-nav" aria-labelledby="mobile-heading">
        <div class="drawer-head">
            <strong id="mobile-heading">Navigation</strong>
            <button class="icon-button" type="button" aria-label="Close navigation" data-menu-close>
                <X size={20} />
            </button>
        </div>
        <nav aria-label="Mobile navigation">
            {sections.map(({ label, slug, description, icon: Icon }) => (
                <a href={href(slug)} aria-current={current === slug ? 'page' : undefined}>
                    <Icon size={21} aria-hidden="true" />
                    <span>
                        <strong>{label}</strong>
                        <small>{description}</small>
                    </span>
                    <ArrowUpRight className="directional-icon" size={16} aria-hidden="true" />
                </a>
            ))}
        </nav>
        <a class="drawer-contact" href={'mailto:' + profile.contact.email}>
            <Mail size={16} aria-hidden="true" />
            Get in touch
        </a>
    </dialog>
    <noscript>
        <style is:inline>
            .site-header :is([data-menu-open], [data-ask-open], [data-theme-toggle]) {
                display: none;
            }
        </style>
        <details class="mobile-fallback">
            <summary>Navigation</summary>
            <nav aria-label="Mobile navigation">
                {sections.map(({ label, slug }) => (
                    <a href={href(slug)} aria-current={current === slug ? 'page' : undefined}>
                        {label}
                    </a>
                ))}
            </nav>
        </details>
    </noscript>
</header>
<script>
    const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    function syncThemeButton() {
        themeButton?.setAttribute(
            'aria-pressed',
            String(document.documentElement.dataset.theme === 'dark'),
        );
    }
    syncThemeButton();
    themeButton?.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        try {
            localStorage.setItem('yok-theme', theme);
        } catch {
            /* The theme still applies to this visit. */
        }
        syncThemeButton();
        window.dispatchEvent(new CustomEvent('yok-theme-change', { detail: { theme } }));
    });
    window.addEventListener('yok-theme-change', syncThemeButton);
    const resourceMenu = document.querySelector<HTMLDetailsElement>('[data-resource-menu]');
    document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        if (resourceMenu?.open && !resourceMenu.contains(event.target)) resourceMenu.open = false;
        if (event.target.closest('[data-ask-open]'))
            window.dispatchEvent(new CustomEvent('yok-open-ask'));
    });
    resourceMenu?.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && resourceMenu.open) {
            resourceMenu.open = false;
            resourceMenu.querySelector('summary')?.focus();
        }
    });
    resourceMenu?.addEventListener('focusout', (event) => {
        if (event.relatedTarget instanceof Node && !resourceMenu.contains(event.relatedTarget))
            resourceMenu.open = false;
    });
    const key = document.querySelector('[data-search-key]');
    if (key && /Macintosh|iPhone|iPad/.test(navigator.userAgent)) key.textContent = '⌘ K';
    const drawer = document.querySelector<HTMLDialogElement>('#mobile-nav');
    const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-open]');
    menuButton?.addEventListener('click', () => {
        if (!drawer || drawer.open) return;
        drawer.showModal();
        menuButton.setAttribute('aria-expanded', 'true');
    });
    drawer?.addEventListener('click', (event) => {
        if (
            event.target instanceof Element &&
            (event.target === drawer || event.target.closest('[data-menu-close], a[href]'))
        )
            drawer.close();
    });
    drawer?.addEventListener('close', () => {
        menuButton?.setAttribute('aria-expanded', 'false');
        if (window.matchMedia('(max-width: 780px)').matches)
            menuButton?.focus({ preventScroll: true });
    });
    window.matchMedia('(max-width: 780px)').addEventListener('change', (event) => {
        if (!event.matches && drawer?.open) drawer.close();
        if (event.matches && resourceMenu) resourceMenu.open = false;
    });
</script>
<style>
    .site-header {
        position: sticky;
        inset-block-start: 0;
        z-index: 35;
        background: var(--bg-canvas);
        color: var(--ink-primary);
        border-block-end: 1px solid var(--border-hairline);
    }
    .nav-shell {
        margin: auto;
        max-width: 1580px;
        min-height: 68px;
        padding-inline: var(--page-gutter);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }
    .brand,
    .nav-link,
    .utilities,
    .search-button,
    .icon-button,
    .contact,
    .drawer-contact {
        display: inline-flex;
        align-items: center;
    }
    .brand,
    .nav-link,
    .contact,
    .drawer-contact,
    .resource-pane a,
    dialog nav a {
        text-decoration: none;
        color: inherit;
    }
    .brand {
        gap: 0.6rem;
        min-height: 44px;
        flex: none;
        font: 760 clamp(1.15rem, 1.65vw, 1.55rem)/1 var(--font-display);
        letter-spacing: -0.065em;
        white-space: nowrap;
    }
    .desktop-links {
        display: flex;
        align-items: center;
        gap: clamp(0.7rem, 2.4vw, 2.5rem);
    }
    .nav-link {
        cursor: pointer;
        min-height: 44px;
        gap: 0.35rem;
        position: relative;
        font: 600 0.88rem/1.3 var(--font-sans);
    }
    .nav-link::after {
        content: '';
        position: absolute;
        inset: auto 0 0.3rem;
        height: 2px;
        background: var(--accent-primary);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.18s ease-out;
    }
    .nav-link:dir(rtl)::after {
        transform-origin: right;
    }
    .nav-link:where(:hover, :focus-visible, [aria-current], .resource-current)::after,
    .resource-menu[open] summary::after {
        transform: scaleX(1);
    }
    .resource-menu {
        position: relative;
    }
    summary {
        list-style: none;
    }
    summary::-webkit-details-marker {
        display: none;
    }
    summary :global(svg) {
        transition: transform 0.2s ease;
    }
    details[open] summary :global(svg) {
        transform: rotate(180deg);
    }
    .resource-pane {
        width: min(32rem, 80vw);
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1px;
        position: absolute;
        z-index: 2;
        inset-block-start: calc(100% + 0.7rem);
        inset-inline-start: -1rem;
        border: 1px solid var(--border-strong);
        background: var(--border-hairline);
        box-shadow: 0 14px 34px #07132724;
    }
    .resource-menu[open] .resource-pane,
    dialog[open] {
        animation: panel-appear 0.2s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .resource-pane a,
    dialog nav a {
        display: flex;
        gap: 0.8rem;
        align-items: center;
        padding: 1rem;
        background: var(--bg-surface);
    }
    .resource-pane a:hover,
    dialog nav a:hover,
    .resource-pane a[aria-current],
    dialog nav a[aria-current] {
        background: var(--accent-tint);
    }
    .resource-pane :global(svg),
    dialog nav :global(svg:first-child) {
        color: var(--accent-primary);
    }
    .resource-pane :is(small, strong),
    dialog nav :is(small, strong) {
        display: block;
    }
    .resource-pane strong,
    dialog nav strong {
        font: 650 1rem/1.3 var(--font-display);
    }
    .resource-pane small,
    dialog nav small {
        margin-block-start: 0.16rem;
        color: var(--ink-secondary);
        font-size: 0.8rem;
        line-height: 1.4;
    }
    .utilities {
        gap: 0.35rem;
    }
    .icon-button,
    .search-button,
    .contact {
        justify-content: center;
        gap: 0.4rem;
        min-height: 44px;
        background: transparent;
        color: inherit;
        border: 1px solid transparent;
        font: 600 0.85rem/1 var(--font-sans);
    }
    .icon-button {
        width: 44px;
        padding: 0;
    }
    .search-button {
        padding: 0 0.72rem;
        border-color: var(--border-hairline);
        background: var(--bg-surface);
    }
    .search-button kbd {
        font: 500 0.64rem/1 var(--font-mono);
        color: var(--ink-muted);
        padding: 0.25rem 0.3rem;
        border: 1px solid var(--border-hairline);
        border-radius: 3px;
    }
    .icon-button:hover,
    .search-button:hover {
        background: var(--bg-subtle);
    }
    .contact {
        background: var(--ink-primary);
        color: var(--bg-surface);
        padding: 0 0.85rem;
    }
    .contact:hover {
        background: var(--accent-primary);
    }
    .theme :global(.sun-icon),
    .menu-trigger,
    .mobile-fallback {
        display: none;
    }
    :global([data-theme='dark']) .theme :global(.sun-icon) {
        display: block;
    }
    :global([data-theme='dark']) .theme :global(.moon-icon) {
        display: none;
    }
    dialog {
        position: fixed;
        inset: auto 0 0;
        margin: 0 auto;
        width: 100%;
        max-width: 32rem;
        max-height: 90dvh;
        padding: 0;
        background: var(--bg-surface);
        color: var(--ink-primary);
        border: 1px solid var(--border-strong);
        border-block-start: 4px solid var(--assembly-blue);
        overscroll-behavior: contain;
    }
    dialog::backdrop {
        background: #0b142bb0;
    }
    .drawer-head {
        padding: 0.5rem 0.8rem 0.5rem 1.1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-block-end: 1px solid var(--border-hairline);
    }
    .drawer-head strong {
        font: 700 1.35rem var(--font-display);
        letter-spacing: -0.04em;
    }
    dialog nav a {
        border-block-end: 1px solid var(--border-hairline);
        padding: 0.68rem 1.1rem;
    }
    dialog nav a :global(svg:last-child) {
        margin-inline-start: auto;
    }
    .drawer-contact {
        gap: 0.5rem;
        color: var(--accent-primary);
        min-height: 48px;
        padding-inline: 1.1rem;
        font-weight: 600;
    }
    .mobile-fallback {
        padding: 0 var(--page-gutter) 0.6rem;
    }
    .mobile-fallback summary {
        cursor: pointer;
    }
    .mobile-fallback nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1rem;
    }
    .mobile-fallback a {
        display: inline-flex;
        align-items: center;
        color: var(--accent-primary);
    }
    @keyframes panel-appear {
        from {
            opacity: 0;
            translate: 0 8px;
        }
        to {
            opacity: 1;
            translate: 0 0;
        }
    }
    @media (max-width: 1000px) {
        .contact {
            display: none;
        }
    }
    @media (max-width: 780px) {
        .desktop-links {
            display: none;
        }
        .menu-trigger {
            display: inline-flex;
        }
        .mobile-fallback {
            display: block;
        }
        .nav-shell {
            min-height: 58px;
            gap: 0.4rem;
        }
        .search-button kbd {
            display: none;
        }
    }
    @media (max-width: 420px) {
        .nav-shell {
            padding-inline: 0.75rem;
        }
        .brand {
            gap: 0.4rem;
            font-size: 1.08rem;
        }
        .brand img {
            width: 28px;
            height: 28px;
        }
        .utilities {
            gap: 0;
        }
        .search-button {
            padding: 0 0.4rem;
            border-color: transparent;
            background: transparent;
        }
    }
    @media (max-width: 360px) {
        .nav-shell {
            padding-inline: 0.56rem;
            gap: 0.25rem;
        }
        .brand {
            gap: 0.3rem;
            font-size: 1rem;
        }
        .brand img {
            width: 25px;
            height: 25px;
        }
        .search-button :global(svg) {
            display: none;
        }
    }
    @media print {
        .site-header {
            display: none !important;
        }
    }
</style>
