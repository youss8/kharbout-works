---
import { ArrowRight } from 'lucide-react';
import SandboxGuide from './SandboxGuide.astro';
import ServiceDesk from '../demos/ServiceDeskDemo';
import Estate from '../demos/EstateOverviewDemo';
import Leave from '../demos/LeaveEngineDemo.astro';
import Attendance from '../demos/AttendanceAmendDemo.astro';
import Kpi from '../demos/KpiCockpitDemo.astro';
import Funding from '../demos/FundingFlowDemo.astro';
import { sandboxChallenges, sandboxTitles } from '../../data/sandbox-directory';

interface Props {
    code: string;
    order: number;
    demoIds: string[];
    featured?: boolean;
}

const { code, order, demoIds, featured = false } = Astro.props;
const demoCodes = [['1A', '1B'], ['2A', '2C'], ['3A', '3B']][order - 1];
---
<section id="sandboxes" class:list={[{ 'featured-sandboxes': featured }]}>
    {featured ? (
        <div class="workflows-heading">
            <h2>Try the workflows</h2>
            <p>These demos use sample data.</p>
        </div>
    ) : <h2>Live sandboxes</h2>}
    {demoIds.map((id, i) => {
        const next = demoIds[i + 1];
        return (
            <section id={id} aria-label={sandboxTitles[id]} class="sandbox">
                <div class="sandbox-heading">
                    {!featured && <span class="section-id">{code} / {demoCodes[i]}</span>}
                    <h3>{sandboxTitles[id]}</h3>
                </div>
                {sandboxChallenges[id] && <SandboxGuide challenge={sandboxChallenges[id]} />}
                {id === 'service-desk' && <ServiceDesk client:load />}
                {id === 'estate-overview' && <Estate client:load />}
                {id === 'leave-engine' && <Leave />}
                {id === 'attendance-amend' && <Attendance />}
                {id === 'kpi-cockpit' && <Kpi />}
                {id === 'funding-flow' && <Funding />}
                {featured && <div class="workflow-footer">
                    <a href={next ? '#' + next : '#scope'}>
                        {next ? sandboxTitles[next] : 'What I designed and built'} <ArrowRight size={16} className="directional-icon" aria-hidden="true" />
                    </a>
                </div>}
            </section>
        );
    })}
</section>
<style>
    .workflows-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .35rem 1rem; }
    .workflows-heading h2 { font-size: clamp(1.55rem, 3.2vw, 2.65rem); font-weight: 700; }
    .workflows-heading p { color: var(--ink-secondary); font-size: .86rem; }
    .featured-sandboxes .sandbox { margin-block: .95rem clamp(1.2rem, 3vw, 2rem); border-color: var(--border-hairline); border-radius: .8rem; }
    .featured-sandboxes .sandbox-heading { padding-block-end: .75rem; margin-block-end: .8rem; }
    .featured-sandboxes .sandbox-heading h3 { margin: 0; font-size: clamp(1.17rem, 2.4vw, 1.75rem); font-weight: 700; }
    .workflow-footer { margin-block-start: .85rem; border-block-start: 1px solid var(--border-hairline); }
    .workflow-footer a { display: inline-flex; align-items: center; gap: .45rem; min-block-size: 44px; color: var(--accent-primary); font-size: .86rem; font-weight: 700; text-underline-offset: .22em; }
    .workflow-footer a:hover { text-decoration: underline; }
</style>
