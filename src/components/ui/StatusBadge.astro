---
interface Props {
  label: string;
  shape?: 'solid' | 'surface' | 'outline' | 'dashed';
  tone?: 'neutral' | 'accent' | 'ok' | 'warn' | 'crit';
  value?: number | null;
}
const { label, value, shape = 'outline', tone = 'neutral' } = Astro.props;
const activeTone = value === 0 || value === null ? 'neutral' : tone;
const glyphs = { neutral: '○', accent: '○', ok: '●', warn: '◐', crit: '■' };
---
<span class:list={['status-badge', shape]} data-tone={activeTone}>
  <span aria-hidden="true">{glyphs[activeTone]}</span>
  <span>{label}</span>
  {value !== undefined && <bdi aria-label={value === null ? 'not set' : undefined}>{value ?? '—'}</bdi>}
</span>
