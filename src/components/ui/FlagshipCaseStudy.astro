---
import type { CollectionEntry } from 'astro:content';
import { ArrowDown, ArrowRight, Boxes, CodeXml, Play } from 'lucide-react';
import SectionRail from './SectionRail.astro';

type System = CollectionEntry<'systems'>['data'];
interface Props {
    data: System;
    presentation: NonNullable<System['presentation']>;
}

const { data, presentation } = Astro.props;
---
<article class="flagship page-shell">
    <header class="case-hero">
        <div class="case-intro">
            <a class="systems-link" href="/systems/">All case studies</a>
            <h1>{presentation.headline}</h1>
            <p>{presentation.introduction}</p>
        </div>
        <nav class="workflow-picker" aria-label="Open a workflow">
            <div class="picker-heading"><Play size={16} aria-hidden="true" /> Interactive workflows</div>
            {presentation.workflows.map(workflow => (
                <a href={'#' + workflow.id}>
                    <span><strong>{workflow.title}</strong><small>{workflow.task}</small></span>
                    <ArrowDown size={17} aria-hidden="true" />
                </a>
            ))}
        </nav>
    </header>

    <SectionRail inline links={[
        ['sandboxes', 'Workflows'],
        ['scope', 'My contribution'],
        ['decisions', 'Design decisions'],
        ['technical-reference', 'Technical reference'],
    ]} />

    <div class="case-band workflow-band">
        <slot name="workflows" />
    </div>

    <section id="scope" class="case-band" aria-labelledby="contribution-heading">
        <h2 id="contribution-heading">What I designed and built</h2>
        <div class="scope-summary">
            <span class="type-label">{data.ownershipPercent} · {data.teamSize}</span>
            <p>{data.scopeNote}</p>
        </div>
        <div class="contribution-grid">
            <section class="case-card">
                <div class="card-title"><span><Boxes size={20} strokeWidth={1.7} aria-hidden="true" /></span><h3>Designed</h3></div>
                <ul>{presentation.designed.map(item => <li>{item}</li>)}</ul>
            </section>
            <section class="case-card">
                <div class="card-title"><span><CodeXml size={20} strokeWidth={1.7} aria-hidden="true" /></span><h3>Built</h3></div>
                <ul>{presentation.built.map(item => <li>{item}</li>)}</ul>
            </section>
        </div>
        <p class="context"><strong>Operational context</strong> {data.realWorldScale}</p>
    </section>

    <section id="decisions" class="case-band" aria-labelledby="decisions-heading">
        <h2 id="decisions-heading">Design decisions</h2>
        <div class="decision-grid">
            {presentation.decisions.map(decision => (
                <section class="case-card decision">
                    <h3>{decision.title}</h3>
                    <p>{decision.rationale}</p>
                    <a href={'#' + decision.workflow}>
                        {decision.action} <ArrowRight size={15} className="directional-icon" aria-hidden="true" />
                    </a>
                </section>
            ))}
        </div>
    </section>

    <section id="technical-reference" class="case-band" aria-labelledby="technical-heading">
        <h2 id="technical-heading">Technical reference</h2>
        <nav class="technical-links" aria-label="Technical reference sections">
            <a href="#architecture">Architecture</a>
            <a href="#audit">Codebase audit</a>
            <a href="#modeling">Data modeling</a>
            <a href="#diagram">Entity relationships</a>
            <a href="#permissions">Access and roles</a>
        </nav>
        <div class="study-copy technical-copy">
            <slot />
        </div>
    </section>
</article>
<style>
    .flagship {
        padding-block-start: clamp(.85rem, 4vw, 3.75rem);
        --band-gap: clamp(2.2rem, 5vw, 4.5rem);
    }
    .case-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr);
        align-items: center;
        gap: clamp(1.25rem, 5vw, 5rem);
        margin-block-end: clamp(1.35rem, 3vw, 2.6rem);
    }
    .case-intro { min-inline-size: 0; }
    .systems-link {
        display: inline-flex;
        align-items: center;
        min-block-size: 44px;
        color: var(--accent-primary);
        font-size: .84rem;
        font-weight: 700;
        text-underline-offset: .22em;
    }
    .systems-link:hover { text-decoration: underline; }
    .case-intro h1 {
        max-inline-size: 17ch;
        margin-block: .4rem .8rem;
        font-size: clamp(2rem, 5vw, 4.65rem);
        line-height: 1.02;
        font-weight: 700;
        letter-spacing: -.055em;
        text-wrap: pretty;
    }
    .case-intro p {
        max-inline-size: 52ch;
        color: var(--ink-secondary);
        font-size: clamp(.92rem, 1.4vw, 1.14rem);
        line-height: 1.65;
    }
    .workflow-picker {
        display: grid;
        gap: .45rem;
        padding: clamp(.55rem, 1.5vw, .9rem);
        min-inline-size: 0;
        border: 1px solid var(--border-hairline);
        border-radius: .9rem;
        color: #e0f2ea;
        background: #103c31;
        box-shadow: 0 18px 45px -28px #09291f55;
    }
    .picker-heading { display: flex; align-items: center; gap: .5rem; padding: .4rem .5rem .25rem; font-size: .81rem; font-weight: 700; }
    .workflow-picker a {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: .65rem;
        min-block-size: 44px;
        border: 1px solid var(--border-hairline);
        border-radius: .55rem;
        background: var(--bg-surface);
        color: var(--ink-primary);
        padding: clamp(.6rem, 1.6vw, .95rem);
        text-decoration: none;
    }
    .workflow-picker a:hover { background: var(--accent-tint); border-color: var(--accent-primary); }
    .workflow-picker a:focus-visible { outline-color: #b3eed6; }
    .workflow-picker strong, .workflow-picker small { display: block; }
    .workflow-picker strong { font-size: clamp(.88rem, 1.5vw, 1.04rem); }
    .workflow-picker small { margin-block-start: .12rem; font-size: .77rem; color: var(--ink-secondary); }
    .workflow-picker a :global(svg) { color: var(--accent-primary); }
    .case-band { min-inline-size: 0; margin-block-start: var(--band-gap); }
    .workflow-band { margin-block-start: clamp(1.4rem, 3vw, 2.6rem); }
    .case-band > h2 {
        font-size: clamp(1.55rem, 3.2vw, 2.65rem);
        font-weight: 700;
        margin-block-end: 1rem;
    }
    .scope-summary {
        display: grid;
        gap: .35rem;
        padding: clamp(.7rem, 2vw, 1.05rem);
        margin-block-end: .75rem;
        border-inline-start: 3px solid var(--accent-primary);
        border-radius: .4rem;
        background: var(--accent-tint);
    }
    .scope-summary .type-label { color: var(--accent-primary); }
    .scope-summary p { max-inline-size: 78ch; font-size: .9rem; }
    .contribution-grid, .decision-grid { display: grid; gap: .75rem; }
    .contribution-grid { grid-template-columns: repeat(auto-fit, minmax(min(100%, 21rem), 1fr)); }
    .decision-grid { grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }
    .case-card {
        display: grid;
        align-content: start;
        gap: .55rem;
        min-inline-size: 0;
        padding: clamp(.85rem, 2vw, 1.35rem);
        border: 1px solid var(--border-hairline);
        border-radius: .7rem;
        background: var(--bg-surface);
    }
    .case-card h3 { font-size: clamp(1.04rem, 1.75vw, 1.25rem); font-weight: 700; }
    .card-title { display: flex; gap: .65rem; align-items: center; }
    .card-title > span { display: grid; place-items: center; inline-size: 2.2rem; block-size: 2.2rem; color: var(--accent-primary); background: var(--accent-tint); border-radius: .45rem; }
    .case-card ul { display: grid; gap: .4rem; padding-inline-start: 1.15rem; list-style: disc; }
    .case-card p, .case-card li, .context { color: var(--ink-secondary); font-size: .87rem; line-height: 1.65; }
    .case-card li::marker { color: var(--accent-primary); }
    .context { margin-block-start: .95rem; max-inline-size: 75ch; }
    .context strong { color: var(--ink-primary); margin-inline-end: .2rem; }
    .decision { grid-template-rows: auto 1fr auto; }
    .decision a, .technical-links a {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        min-block-size: 44px;
        inline-size: fit-content;
        color: var(--accent-primary);
        font-size: .85rem;
        font-weight: 700;
        text-underline-offset: .22em;
    }
    .decision a:hover, .technical-links a:hover { text-decoration: underline; }
    .technical-links { display: flex; flex-wrap: wrap; gap: .2rem 1rem; border-block: 1px solid var(--border-hairline); padding-block: .25rem; }
    .technical-copy { max-inline-size: 72rem; }
    .technical-copy :global(h2) { margin-block: clamp(1.65rem, 3vw, 2.5rem) .65rem; font-size: clamp(1.2rem, 2.25vw, 1.8rem); font-weight: 700; }
    .technical-copy :global(table) { table-layout: fixed; border: 1px solid var(--border-hairline); }
    .technical-copy :global(:is(th,td)) { overflow-wrap: anywhere; padding: clamp(.4rem, 1.3vw, .75rem); }
    .technical-copy :global(th:first-child) { inline-size: 34%; }
    .technical-copy :global(#audit + p + table th:first-child) { inline-size: 74%; }
    @media (max-width: 720px) {
        .case-hero { grid-template-columns: minmax(0, 1fr); }
    }
</style>
