<div class="kpi-demo" x-data="kpiCockpit">
  <header class="demo-heading">
    <p>Inspect site returns through 30 September 2026.</p>
    <button type="button" x-on:click="reset">Reset Demo State</button>
  </header>
  <p>Each period measures progress toward the annual target at its closing date.</p>
  <div class="kpi-stats">
    <div><strong x-text="rows.filter(row => row.state.name === 'On track').length"></strong><span>KPIs on track</span></div>
    <div><strong x-text="targetAchievement"></strong><span>Targets achieved</span></div>
    <div><strong x-text="siteCount"></strong><span>Sites reporting</span></div>
    <div><strong x-text="gaps.length"></strong><span>Data gaps</span></div>
  </div>
  <div class="kpi-filters">
    <label>Sponsor<select x-model="sponsor"><option value="">All sponsors</option><template x-for="s in sponsors" :key="s.id"><option :value="s.id" x-text="s.name"></option></template></select></label>
    <label>Site<select x-model="site"><option value="">All sites</option><template x-for="s in sites" :key="s.id"><option :value="s.id" x-text="s.name"></option></template></select></label>
    <label>Period<select x-model="period"><template x-for="p in periods"><option :value="p" x-text="p"></option></template></select></label>
    <label class="pending-toggle"><input type="checkbox" x-model="includePending" /> Include pending</label>
  </div>
  <div class="kpi-layout">
    <section class="tree" aria-label="Objective tree">
      <h4>Objective tree</h4><p class="cutoff" x-text="'Annual time elapsed · ' + Math.round(elapsed * 100) + '%'"></p>
      <template x-for="node in visibleNodes" :key="node.id">
        <div class="branch" :style="'--level:' + node.depth">
          <div class="branch-label">
            <template x-if="node.children?.length"><button class="branch-toggle" type="button" :aria-expanded="!collapsed.includes(node.id)" :aria-label="'Toggle ' + node.title" x-on:click="toggleNode(node.id)" x-text="collapsed.includes(node.id) ? '+' : '−'"></button></template>
            <span><small class="mono" x-text="node.id + ' / ' + node.level"></small><strong x-text="node.title"></strong></span>
          </div>
          <template x-if="node.level === 'outcome' && !node.kpis.length"><span class="status-badge dashed">– No KPI</span></template>
          <template x-for="kpi in node.kpis ?? []" :key="kpi.id">
            <div class="indicator" :class="{ picked: selected === kpi.code }">
              <button type="button" class="indicator-name" x-on:click="selected = kpi.code" :aria-pressed="selected === kpi.code"><span class="mono" x-text="kpi.code"></span> <span x-text="kpi.name"></span></button>
              <span class="status-badge" :class="summary(kpi).state.shape" :data-tone="summary(kpi).state.tone" x-text="summary(kpi).state.icon + ' ' + summary(kpi).state.name"></span>
              <p class="reading"><strong x-text="show(summary(kpi).actual, kpi)"></strong> / <span x-text="show(summary(kpi).target, kpi)"></span><span x-show="summary(kpi).pending" x-text="' · +' + summary(kpi).pending + ' pending'"></span></p>
              <div class="track" aria-hidden="true"><i :style="'width:' + summary(kpi).progress + '%'"></i><i class="pending" :style="'width:' + summary(kpi).pendingWidth + '%'"></i></div>
              <div class="target-chips"><template x-for="t in matching(kpi)" :key="t.site"><small :title="siteName(t.site)" x-text="t.site + ' · ' + show(t.target, kpi)"></small></template></div>
            </div>
          </template>
        </div>
      </template>
    </section>
    <section class="inspector" aria-label="KPI inspector">
      <p class="mono" x-text="selected"></p><h4 x-text="current.name"></h4>
      <template x-if="current.measure === 'percentage'">
        <div class="method">
          <label>Rollup method<select x-model="method"><option value="pooled">Pooled ratio (correct)</option><option value="naive">Naive average (wrong)</option></select></label>
          <output class="result-value" aria-live="polite" :aria-label="result.actual === null ? 'not set' : null"><bdi x-text="show(result.actual)"></bdi></output>
          <p x-show="method === 'pooled'" x-text="'Σ numerators ' + result.numerator + ' / Σ denominators ' + result.denominator"></p>
          <p x-show="method === 'naive'">Each reporting site receives equal weight.</p>
          <template x-for="note in exclusionNotes" :key="note"><p x-text="note"></p></template>
        </div>
      </template>
      <p x-show="current.cumulative" class="explain">Latest approved site readings at the reporting cutoff. Earlier snapshots are unavailable.</p>
      <div class="inspector-tabs" aria-label="Inspector view"><template x-for="name in ['Matrix','Trend','Gaps']"><button type="button" x-text="name" :aria-pressed="inspector === name" x-on:click="inspector = name"></button></template></div>
      <div x-show="inspector === 'Matrix'">
        <div class="matrix-scroll" tabindex="0" role="region" aria-label="Monthly site returns">
          <table><caption>Monthly site returns</caption><thead><tr><th>Site</th><template x-for="m in displayedMonths" :key="m.key"><th x-text="m.name"></th></template></tr></thead>
            <tbody><template x-for="t in targets" :key="t.site"><tr><th scope="row" x-text="siteName(t.site)"></th><template x-for="m in displayedMonths" :key="m.key"><td :aria-label="cell(t,m) === '—' ? 'not set' : null"><bdi x-text="cell(t,m)"></bdi></td></template></tr></template></tbody>
          </table>
        </div>
        <p class="explain" x-show="!targets.length">No targets match these filters.</p>
        <p class="explain">A dash means no reading was supplied.</p>
      </div>
      <div x-show="inspector === 'Trend'">
        <p class="explain">Each line compares the reported total with the annual target at a linear pace.</p>
        <table><thead><tr><th>Month</th><th>Actual</th><th>Linear target</th></tr></thead><tbody><template x-for="m in displayedMonths" :key="m.key"><tr><th scope="row" x-text="m.name"></th><td x-text="show(summary(current,m.index).actual)"></td><td x-text="show(result.target === null ? null : result.target * (m.index + 1) / 12)"></td></tr></template></tbody></table>
      </div>
      <div x-show="inspector === 'Gaps'"><ul><template x-for="gap in gaps" :key="gap"><li x-text="gap"></li></template></ul></div>
    </section>
  </div>
  <details><summary>What Engineering Invariant Is Running Here?</summary><p>Count KPIs sum approved returns. A cumulative KPI uses each site's latest value. Percentage KPIs pool the numerator and denominator of each reporting site, excluding missing denominators. Pending counts stay in a separate band. Pacing compares achievement with elapsed annual time, with on-track and attention thresholds of 0.9 and 0.7.</p></details>
</div>
<style>
  .kpi-demo { container-type: inline-size; }
  .demo-heading,.kpi-filters,.pending-toggle,.branch-label,.target-chips,.inspector-tabs { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; }
  .demo-heading { justify-content: space-between; margin-block-end: .65rem; }
  .demo-heading p,.inspector > p:first-child,.cutoff,.branch-label small { color: var(--ink-secondary); font-size: .74rem; }
  .kpi-stats { display: grid; grid-template-columns: repeat(4,1fr); margin: 1rem 0; border: 1px solid var(--border-hairline); }
  .kpi-stats div { padding: .75rem; border-inline-end: 1px solid var(--border-hairline); }
  .kpi-stats div:last-child { border: 0; }.kpi-stats span,.kpi-filters label,.method label,.branch-label span > *, .result-value { display: block; }
  .kpi-stats strong,.result-value { font: 600 1.5rem/1.3 var(--font-mono); }
  .kpi-stats span,.target-chips small,.kpi-demo label,.kpi-demo table,.explain { font-size: .8rem; }
  .kpi-filters { align-items: end; }.kpi-filters select,.method select { display: block; max-width: 100%; margin-block-start: .2rem; }.kpi-filters .pending-toggle { display: flex; padding-block: .5rem; }
  .kpi-layout { display: grid; grid-template-columns: minmax(0,3fr) minmax(0,2fr); margin-block: 1rem; border: 1px solid var(--border-hairline); }
  .tree,.inspector { padding: clamp(.65rem,2cqw,1.1rem); min-width: 0; }.tree { border-inline-end: 1px solid var(--border-hairline); }.kpi-layout h4 { margin: 0; font-size: 1rem; font-weight: 700; }
  .branch { margin-inline-start: calc(var(--level) * .65rem); padding-block-start: .7rem; }.branch-label { flex-wrap: nowrap; align-items: start; }.branch-label strong { font-size: .85rem; }
  .branch-toggle { min-width: 1.75rem; min-height: 1.75rem; }.indicator { margin-block: .55rem; padding: .6rem; border: 1px solid var(--border-hairline); border-inline-start: 2px solid var(--border-hairline); }
  .indicator.picked { border-inline-start-color: var(--accent-primary); }.indicator-name { display: block; text-align: start; margin-block-end: .35rem; }.reading { margin-block-start: .4rem; font-family: var(--font-mono); }
  .track { height: .36rem; display: flex; background: var(--bg-subtle); margin-block: .4rem; }.track i { display: block; background: var(--accent-primary); }.track i.pending { background: var(--status-warn); opacity: .48; }
  .target-chips { gap: .25rem; }.target-chips small { padding: .05rem .25rem; border: 1px solid var(--border-hairline); font-family: var(--font-mono); font-size: .68rem; }
  .method { padding: .75rem; border-block: 1px solid var(--border-hairline); margin-block: .65rem; background: var(--bg-subtle); }.method p,.inspector li { font-size: .8rem; }.result-value { margin-block: .5rem; color: var(--accent-primary); }
  .inspector-tabs { margin-block: .8rem; gap: .25rem; }.inspector-tabs button[aria-pressed=true] { border-color: var(--accent-primary); color: var(--accent-primary); }
  .matrix-scroll { overflow-x: auto; max-width: 100%; }.matrix-scroll caption { text-align: start; font-weight: 600; }.kpi-demo th,.kpi-demo td { text-align: start; padding: .3rem .4rem; }.kpi-demo table { width: 100%; }
  .explain { color: var(--ink-secondary); margin-block: .35rem; }.kpi-demo details { margin-block-start: 1rem; }
  @container (max-width: 640px) { .kpi-layout { grid-template-columns: minmax(0,1fr); }.tree { border-inline-end: 0; border-block-end: 1px solid var(--border-hairline); }.kpi-stats { grid-template-columns: repeat(2,1fr); }.kpi-stats div { border: 1px solid var(--border-hairline); } }
</style>
