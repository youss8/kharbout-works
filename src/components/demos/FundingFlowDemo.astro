---
import { fundingEdges } from './portfolio-alpine.js';
---
<div class="funding-demo" x-data="fundingFlow">
  <header class="demo-heading"><p>Portfolio date <time datetime="2026-11-23">23 November 2026</time>.</p><button type="button" x-on:click="reset">Reset Demo State</button></header>
  <div class="fund-totals"><template x-for="bucket in totals" :key="bucket.currency">
    <section><small class="mono" x-text="bucket.currency"></small><strong x-text="money(bucket.agreed,bucket.currency)"></strong><span>Agreed</span>
      <dl><div><dt>Requested</dt><dd x-text="money(bucket.requested,bucket.currency)"></dd></div><div><dt>Received, gross</dt><dd x-text="money(bucket.received,bucket.currency)"></dd></div></dl>
    </section>
  </template></div>
  <div class="health-chips" aria-label="Filter agreement health">
    <button type="button" :aria-pressed="healthFilter === ''" x-on:click="healthFilter = ''">All <span x-text="agreements.length"></span></button>
    <template x-for="[key, state] in Object.entries(healthLabels)" :key="key"><button type="button" :class="'status-badge ' + state.shape" :data-tone="state.tone" :aria-pressed="healthFilter === key" x-on:click="healthFilter = healthFilter === key ? '' : key"><span aria-hidden="true" x-text="state.icon"></span><span x-text="state.name"></span><span x-text="count(key)"></span></button></template>
  </div>
  <figure class="flow-figure">
    <figcaption><strong>Portfolio connections</strong><span>Hover, focus or select a node to trace its funding chain.</span></figcaption>
    <div class="flow-map" x-ref="map" x-on:keydown.escape="pinned = ''; hovered = ''; focused = ''">
      <svg class="ribbons" aria-hidden="true">{fundingEdges.map(({ id, source, target, currency, cents }) => {
        const match = `edges.find(edge => edge.id === ${JSON.stringify(id)})`;
        return <path class={currency} data-source={source} data-target={target} data-currency={currency} data-amount={cents / 100}
          x-bind:d={`${match}?.path ?? ''`} x-bind:stroke-width={`${match}?.width ?? 0`}
          x-bind:class={`{ 'dim-edge': trace && !(related.includes(${JSON.stringify(source)}) && related.includes(${JSON.stringify(target)})) }`}></path>;
      })}</svg>
      <template x-for="column in columns" :key="column.name"><div class="map-column"><h4 x-text="column.name"></h4><template x-for="node in column.nodes" :key="node.id">
        <button type="button" class="map-node" :data-flow-node="node.id" :class="traceClass(node.id)" :aria-pressed="pinned === node.id"
          x-on:mouseenter="hovered = node.id" x-on:mouseleave="hovered = ''" x-on:focus="focused = node.id" x-on:blur="focused = ''"
          x-on:click="pinned = pinned === node.id ? '' : node.id"><small class="mono" x-text="node.id"></small><strong x-text="node.label"></strong></button>
      </template></div></template>
    </div>
    <div class="flow-key"><span><i></i>USD</span><span><i class="eur"></i>EUR</span></div>
    <p>Ribbon width shows agreed funding within each currency. For this simulation, each agreement is divided equally among its proposal’s linked projects.</p>
  </figure>
  <div class="view-tabs" aria-label="Portfolio records"><template x-for="tab in ['Register','Tranche Lanes','Ledger','Calendar']">
    <button type="button" :aria-pressed="activeTab === tab" x-on:click="activeTab = tab" x-text="tab"></button>
  </template></div>
  <div x-show="activeTab === 'Register'" class="fund-table-wrap" role="region" aria-label="Agreements" tabindex="0">
    <table><thead><tr><th>Agreement</th><th>Sponsor</th><th>Budget</th><th>Health</th></tr></thead><tbody>
      <template x-for="a in filtered" :key="a.id"><tr :data-agreement="a.id" :class="traceClass(a.id)" x-on:click="open(a.id)">
        <th scope="row"><button type="button" :aria-label="'Inspect ' + a.id" x-on:click.stop="open(a.id)" x-text="a.id"></button></th>
        <td x-text="name(a.sponsor)"></td><td class="mono" x-text="money(a.budget,a.currency)"></td>
        <td><span :class="'status-badge ' + healthLabels[health(a)].shape" :data-tone="healthLabels[health(a)].tone" x-text="healthLabels[health(a)].icon + ' ' + healthLabels[health(a)].name"></span></td>
      </tr></template>
    </tbody></table>
  </div>
  <div x-show="activeTab === 'Tranche Lanes'" class="lanes"><template x-for="a in filtered" :key="a.id"><section><button type="button" x-on:click="open(a.id)" x-text="a.id"></button><ol><template x-for="t in a.tranches" :key="t.due"><li><time x-text="t.due"></time> · <span x-text="money(t.amount,a.currency)"></span><strong x-text="t.state"></strong></li></template></ol></section></template></div>
  <div x-show="activeTab === 'Ledger'" class="fund-table-wrap" tabindex="0" role="region" aria-label="Received disbursements"><table><thead><tr><th>Received</th><th>Agreement</th><th>Gross</th><th>Net</th></tr></thead><tbody><template x-for="row in ledger" :key="row.agreement + row.due"><tr><td x-text="row.receivedOn"></td><td><button type="button" x-on:click="open(row.agreement)" x-text="row.agreement"></button></td><td x-text="money(row.amount,row.currency)"></td><td x-text="row.net === undefined ? 'Unrecorded' : money(row.net,row.currency)"></td></tr></template></tbody></table><p x-show="!ledger.length">No received tranches match this filter.</p></div>
  <ol class="calendar-list" x-show="activeTab === 'Calendar'"><template x-for="event in calendar" :key="event.date + event.title"><li><time x-text="event.date"></time><span x-text="event.title"></span><small x-text="event.state"></small></li></template></ol>
  <p x-show="!filtered.length">No agreements match this health filter.</p>
  <p class="fund-feedback" role="status" x-text="message"></p>
  <dialog x-ref="drawer" aria-labelledby="fund-detail-title" x-on:click="if ($event.target === $refs.drawer) close()" x-on:close="detailId = ''">
    <div class="drawer-body">
      <header class="demo-heading"><h4 id="fund-detail-title">Agreement detail</h4><button type="button" x-on:click="close">Close</button></header>
      <template x-if="detail"><div><p class="mono" x-text="detail.id"></p><h4 x-text="name(detail.sponsor)"></h4><p x-text="name(detail.proposal)"></p>
        <span :class="'status-badge ' + healthLabels[health(detail)].shape" :data-tone="healthLabels[health(detail)].tone" x-text="healthLabels[health(detail)].icon + ' ' + healthLabels[health(detail)].name"></span>
        <p class="drawer-total" x-text="money(received(detail),detail.currency) + ' received / ' + money(detail.budget,detail.currency) + ' agreed'"></p>
        <h5>Scheduled tranches</h5><ol><template x-for="(t, index) in detail.tranches" :key="t.due"><li><strong x-text="money(t.amount,detail.currency)"></strong> · <time x-text="t.due"></time><p x-text="t.state + (t.receivedOn ? ' · ' + t.receivedOn : '')"></p>
          <p x-show="t.note" x-text="t.note"></p><button type="button" x-show="t.state === 'expected'" x-on:click="markReceived(index)">Mark Tranche Received</button>
        </li></template></ol>
        <h5>Sponsor reports</h5><p x-show="!detail.reports.length">No reports scheduled.</p><ul><template x-for="r in detail.reports"><li x-text="r.type + ' · ' + r.due + ' · ' + r.state"></li></template></ul>
        <p class="fund-feedback" role="status" x-text="message"></p>
      </div></template>
    </div>
  </dialog>
  <details><summary>What Engineering Invariant Is Running Here?</summary><p>A failed tranche makes an agreement off track. Otherwise an overdue expected tranche or overdue requested report needs attention. All remaining agreements are on track. Receiving a tranche updates its gross cash ledger and recomputes its health; net cash remains unrecorded until supplied.</p></details>
</div>
<style>
  .funding-demo { container-type: inline-size; }.demo-heading,.health-chips,.view-tabs,.flow-key { display: flex; align-items: center; flex-wrap: wrap; gap: .55rem; }.demo-heading { justify-content: space-between; margin-bottom:.6rem; }
  .demo-heading .mono,figcaption span,.flow-figure > p,.flow-key,.fund-totals section > span { font-size: .78rem; color: var(--ink-secondary); }
  .fund-totals { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); border: 1px solid var(--border-hairline); margin-block: 1rem; }.fund-totals section { padding: .8rem; }.fund-totals section + section { border-inline-start: 1px solid var(--border-hairline); }
  .fund-totals section > * { display: block; }.fund-totals strong { font: 600 clamp(.9rem,2.4cqw,1.65rem)/1.35 var(--font-mono); }.fund-totals dl { margin-top:.5rem; }.fund-totals dl div { display:flex; flex-wrap:wrap; gap:.25rem .5rem; justify-content:space-between; font-size:.8rem; }.fund-totals dd { margin:0; font-family:var(--font-mono); }
  .health-chips button[aria-pressed=true],.view-tabs button[aria-pressed=true]{ outline:2px solid var(--accent-primary); outline-offset:1px; }
  .flow-figure { margin: 1rem 0; border:1px solid var(--border-hairline); padding:clamp(.4rem,2cqw,1.2rem); }.flow-figure figcaption span { display:block; }
  .flow-map { display:grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap:clamp(.55rem,4.5cqw,3rem); position:relative; margin-block:.8rem; }
  .ribbons { position:absolute; inset:0; width:100%; height:100%; pointer-events:none; }.ribbons path { fill:none; opacity:.72; stroke:var(--accent-primary); }.ribbons .EUR { stroke:var(--status-warn); }.ribbons .dim-edge { opacity:.12; }
  .map-column { position:relative; display:grid; grid-template-rows:auto repeat(3, minmax(3.7rem,1fr)); gap:.5rem; align-items:stretch; min-width:0; }
  .map-column h4 { font-size:.78rem; margin:0; }.map-column .map-node { display:block; min-width:0; width:100%; border:1px solid var(--border-strong); padding:clamp(.22rem,1cqw,.7rem); text-align:start; background:var(--bg-surface); color:var(--ink-primary); overflow-wrap:anywhere; }.map-node small,.map-node strong { display:block; }.map-node small { font-size:.65rem; color:var(--ink-secondary); }.map-node strong { font-size:clamp(.65rem,1.5cqw,.83rem); }
  .map-node.is-dimmed { color:var(--ink-secondary); background:var(--bg-subtle); }.map-column .is-traced { border-color:var(--accent-primary); background:var(--accent-tint); }
  .flow-key { gap: .6rem 1.2rem; }.flow-key span { display:flex; align-items:center; gap:.35rem; }.flow-key i { width:1.25rem; border-top:4px solid var(--accent-primary); }.flow-key .eur { border-color:var(--status-warn); }
  .fund-table-wrap { max-width:100%; overflow-x:auto; }.funding-demo table { width:100%; font-size:.81rem; }.funding-demo :is(th,td) { padding:.45rem; text-align:start; }.funding-demo tr.is-traced { background:var(--accent-tint); }.funding-demo tr[data-agreement] { cursor:pointer; }
  .view-tabs { margin-block: .7rem; }.lanes section,.calendar-list li { display:flex; gap:.5rem 1rem; align-items:start; flex-wrap:wrap; border-bottom:1px solid var(--border-hairline); padding:.55rem 0; }.lanes ol { margin:0; }.lanes li { font-size:.82rem; }.lanes li strong { margin-inline-start:.5rem; }.calendar-list { padding:0; font-size:.85rem; }.calendar-list time { font-family:var(--font-mono); }.calendar-list small { margin-inline-start:auto; }
  .funding-demo dialog { position:fixed; margin:0; inset:0 0 0 auto; width:min(28rem,96vw); max-width:100%; height:100dvh; max-height:100dvh; border:1px solid var(--border-strong); background:var(--bg-surface); color:var(--ink-primary); padding:0; }.funding-demo dialog::backdrop {background:rgb(10 20 15 / 40%);}.drawer-body {padding:1.2rem;min-height:100%;}.drawer-body h4,.drawer-body h5 {margin:.5rem 0;font-weight:700;}.drawer-body ol li {border-block-start:1px solid var(--border-hairline);padding:.6rem 0;}.drawer-total {font-family:var(--font-mono);margin-block:.7rem;}.fund-feedback {color:var(--accent-primary);margin-block:.4rem;}.fund-feedback:empty {display:none;}
  .funding-demo details {margin-block-start:1rem;}
  @container (max-width:440px) { .fund-totals section {padding:.5rem;} .fund-totals dl div {display:block;} .flow-map {gap:.6rem;} }
</style>
